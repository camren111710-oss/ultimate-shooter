addEventListener("keydown", e=>{
  const k = e.key.toLowerCase();
  keys[k] = true;

  if(k==="escape" || k==="p"){
    if(started && !upgradeMode && !soloPicking){ e.preventDefault(); togglePause(); }
    return;
  }

  if(upgradeMode){
    if(bossReward){
      if(e.key==="1") pickBossReward(0);
      if(e.key==="2") pickBossReward(1);
      if(e.key==="3") pickBossReward(2);
    } else {
      if(e.key==="1") pickWeapon(0);
      if(e.key==="2") pickWeapon(1);
      if(e.key==="3") pickWeapon(2);
    }
    return;
  }
  if(!started){
    // menu / game-over screen — keyboard works here too, same as touch & controller
    if(k===" " || k==="enter"){ e.preventDefault(); startGame(); }
    return;
  }
  if(paused) return;

  if(k===" "){ e.preventDefault(); fire(); }
  if(k==="shift") tryDash();
  if(k==="q" || k==="tab"){ e.preventDefault(); switchSlot(); }
  if(k==="[") cycleArsenal(-1);
  if(k==="]") cycleArsenal(1);
  if(k==="r"){ startReload(activeSlot); }

  // legacy directional-shoot support (i/j/k/l & arrows) aims + fires that direction
  let dx=0,dy=0;
  if(k==="i"||k==="arrowup") dy=-1;
  if(k==="k"||k==="arrowdown") dy=1;
  if(k==="j"||k==="arrowleft") dx=-1;
  if(k==="l"||k==="arrowright") dx=1;
  if(dx||dy){
    mouse.x = player.x + dx*200;
    mouse.y = player.y + dy*200;
    touchAim.active = false;
    fire();
  }
});
