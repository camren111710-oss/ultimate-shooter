    width:105px;height:4px;accent-color:var(--accent2);cursor:pointer;
  }
  #poisonvign{
    position:fixed;inset:0;z-index:12;pointer-events:none;opacity:0;
    background:radial-gradient(ellipse at 50% 50%, rgba(105,204,74,0) 55%, rgba(105,204,74,.4) 100%);
