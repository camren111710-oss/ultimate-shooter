  #gameover .best{color:var(--dim);font-size:13px;letter-spacing:1px;animation:menuRise .5s ease .3s backwards;}
  .go-row{display:flex;gap:14px;margin-top:26px;}
  #gostats{
    margin-top:22px;display:flex;flex-direction:column;gap:2px;min-width:260px;
