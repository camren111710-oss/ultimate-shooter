// =========================================================
// UPDATE
// =========================================================
function update(dt){
  if(!started) return;

  if(dashCd > 0) dashCd--;
  if(invulnT > 0) invulnT--;
  if(comboTimer > 0){ comboTimer--; if(comboTimer===0) combo = 0; }
  if(jamMsgT > 0) jamMsgT--;

  if(switching){
    switchT--;
    if(switchT <= 0){
      switching = false;
      activeSlot = activeSlot === "A" ? "B" : "A";
    }
  }

  for(const slot of ["A","B"]){
    if(reloading[slot] && performance.now() - reloadStart[slot] >= reloadDuration[slot]){
      reloading[slot] = false;
      const weaponKey = slot === "A" ? player.weaponA : player.weaponB;
      const w = weapons[weaponKey];
      if(Math.random() < w.jamChance){
        jammed[slot] = true;
        ammo[slot] = 0;
        if(slot === activeSlot) jamMsgT = 70;
        playSfx("jam");
      } else {
        ammo[slot] = w.mag;
      }
    }
  }

  // movement
  player.facingAngle = angleToMouseOrTouch();
  if(!upgradeMode && !soloPicking){
    let mx=0, my=0;
    if(keys.w) my -= 1;
    if(keys.s) my += 1;
    if(keys.a) mx -= 1;
    if(keys.d) mx += 1;
    if(touchMove.active){ mx += touchMove.dx; my += touchMove.dy; }
    if(gpMove.x || gpMove.y){ mx += gpMove.x; my += gpMove.y; }

    const mag = Math.hypot(mx,my);
    if(mag > 0){ mx/=mag; my/=mag; }

    let spd = player.baseSpeed;
    if(dashActiveT > 0){
      spd *= 3.2; dashActiveT--;
      playerTrail.push({ x:player.x, y:player.y, angle:player.facingAngle, life:10, maxLife:10 });
    }

    player.x += mx*spd;
    player.y += my*spd;
    player.vx = mx*spd; player.vy = my*spd;

    const targetBank = mx * 0.5;
    player.bank += (targetBank - player.bank) * 0.2;
    player.bob += 0.08;

    if(mouse.down) fire();
  } else {
    player.vx *= 0.8; player.vy *= 0.8;
  }

  player.x = Math.max(14, Math.min(canvas.width-14, player.x));
  player.y = Math.max(14, Math.min(canvas.height-14, player.y));

  // bullets
  for(let i=bullets.length-1;i>=0;i--){
    const b = bullets[i];
    b.px = b.x; b.py = b.y;

    // homing missiles gently steer toward the nearest enemy
    if(b.homing && !b.enemyBullet){
      let nearest = null, nd = 420;
      for(const e2 of enemies){
        const dd = Math.hypot(e2.x-b.x, e2.y-b.y);
        if(dd < nd){ nd = dd; nearest = e2; }
      }
      if(nearest){
        const spd = Math.hypot(b.dx, b.dy);
        const desired = Math.atan2(nearest.y-b.y, nearest.x-b.x);
        const cur = Math.atan2(b.dy, b.dx);
        const diff = normalizeAngle(desired - cur);
        const turned = cur + Math.max(-0.11, Math.min(0.11, diff));
        b.dx = Math.cos(turned)*spd; b.dy = Math.sin(turned)*spd;
      }
    }

    // boomerangs fly out, then curve back to the player, re-hitting enemies on the way
    if(b.boomerang && !b.enemyBullet){
      if(!b.returning && b.life <= b.outLife/2){
        b.returning = true;
        b.hitSet = new Set();
      }
      if(b.returning){
        const spd = Math.hypot(b.dx, b.dy) || 12;
        const a = Math.atan2(player.y-b.y, player.x-b.x);
        b.dx = Math.cos(a)*spd; b.dy = Math.sin(a)*spd;
        if(Math.hypot(player.x-b.x, player.y-b.y) < 22) b.life = 0;
      }
    }

    // ricochet bullets bounce off the play-field edges instead of despawning
    if(b.bounce > 0 && !b.enemyBullet){
      if((b.x <= 4 && b.dx<0) || (b.x >= canvas.width-4 && b.dx>0)){ b.dx = -b.dx; b.bounce--; spawnParticles(b.x,b.y,b.c,3); }
      if((b.y <= 4 && b.dy<0) || (b.y >= canvas.height-4 && b.dy>0)){ b.dy = -b.dy; b.bounce--; spawnParticles(b.x,b.y,b.c,3); }
    }

    b.x += b.dx; b.y += b.dy; b.life--;
    if(!b.enemyBullet){
      if(b.wtype === "Toxic" && Math.random() < 0.35){
        particles.push({ x:b.x, y:b.y, dx:(Math.random()-0.5)*0.6, dy:(Math.random()-0.5)*0.6+0.4, life:16, maxLife:16, color:"#69cc4a", size:1.6 });
      } else if(b.wtype === "Explosive" && Math.random() < 0.45){
        particles.push({ x:b.x, y:b.y, dx:(Math.random()-0.5)*0.5, dy:(Math.random()-0.5)*0.5, life:14, maxLife:14, color:"#9aa3b5", size:2 });
      } else if(b.wtype === "Singularity" && Math.random() < 0.6){
        particles.push({ x:b.x, y:b.y, dx:(Math.random()-0.5)*1.2, dy:(Math.random()-0.5)*1.2, life:18, maxLife:18, color:"#ff2bd6", size:2.4 });
      } else if(b.burn && Math.random() < 0.5){
        particles.push({ x:b.x, y:b.y, dx:(Math.random()-0.5)*0.8, dy:(Math.random()-0.5)*0.8-0.3, life:12, maxLife:12, color:"#ff8a3d", size:2 });
      }
    }
    const outOfBounds = !b.bounce && (b.x<-40||b.y<-40||b.x>canvas.width+40||b.y>canvas.height+40);
    if(b.life<=0 || outOfBounds){
      bullets.splice(i,1);
    }
  }

  // enemies
  for(let i=enemies.length-1;i>=0;i--){
    const e = enemies[i];
    if(e.hitFlash>0) e.hitFlash--;
    if(e.spawnT>0) e.spawnT--;
    if(e.squash>0) e.squash -= 0.12;
    e.wobble += 0.09;
    if(e.poison>0){
      e.poison--;
      if(e.poison % 20 === 0){ e.hp -= 3; spawnParticles(e.x,e.y,"#69cc4a",2); }
    }
    if(e.burn>0){
      e.burn--;
      if(e.burn % 11 === 0){ e.hp -= 2; spawnParticles(e.x,e.y,"#ff6a1f",2); }
    }

    if(e.type === "boss"){
      updateBoss(e);
    } else if(e.type === "turret"){
      // stationary — plants itself and fires steadily at the player
      e.shootCd--;
      const dist = Math.hypot(player.x-e.x, player.y-e.y);
      if(e.shootCd<=0 && dist < 700){
        e.shootCd = 62;
        const a = Math.atan2(player.y-e.y, player.x-e.x);
        bullets.push({ x:e.x, y:e.y, dx:Math.cos(a)*7.5, dy:Math.sin(a)*7.5, d:9, c:"#b8bec9", life:150, enemyBullet:true, pierce:0, hitSet:new Set() });
      }
    } else {
      const angle = Math.atan2(player.y-e.y, player.x-e.x);
      e.x += Math.cos(angle)*e.speed;
      e.y += Math.sin(angle)*e.speed;

      if(e.type === "shooter"){
        e.shootCd--;
        const dist = Math.hypot(player.x-e.x, player.y-e.y);
        if(e.shootCd<=0 && dist < 650){
          e.shootCd = 95;
          const a = Math.atan2(player.y-e.y, player.x-e.x);
          bullets.push({ x:e.x, y:e.y, dx:Math.cos(a)*7, dy:Math.sin(a)*7, d:8, c:"#ff3860", life:150, enemyBullet:true, pierce:0, hitSet:new Set() });
        }
      }
    }

    // touch player
    const distP = Math.hypot(player.x-e.x, player.y-e.y);
    if(e.type === "bomber" && distP < e.size + 32 && e.hp > 0){
      e.hp = -1; // triggers the bomber's explosion in the death block below
    }
    if(distP < e.size + player.size - 4 && invulnT<=0){
      const dmgTable = { boss:0.55, tank:0.32, shielded:0.26, splitter:0.22, bomber:0, splitling:0.12, runner:0.14, shooter:0.16, normal:0.18, turret:0, vampire:0.2 };
      const dmgAmt = dmgTable[e.type] ?? 0.18;
      hp -= playerTakeDamage(dmgAmt);
      flashAlpha = Math.min(flashAlpha+0.25, 0.5);
      shakeAmt = Math.min(shakeAmt+1.2, 8);
      if(hurtSfxCd<=0 && dmgAmt>0){ playSfx("hurt"); hurtSfxCd = 24; }
      if(e.type === "vampire" && dmgAmt>0){
        const healed = Math.min(e.maxHp - e.hp, e.maxHp*0.06);
        e.hp += healed;
        e.hitFlash = 4;
        spawnParticles(e.x, e.y, "#a3193d", 6);
      }
      if(hp<=0 && !gameOverShown){ hp=0; endGame(); }
    }

    // player bullets hit enemy
    for(let j=bullets.length-1;j>=0;j--){
      const b = bullets[j];
      if(b.enemyBullet) continue;
      if(b.hitSet.has(e)) continue;
      if(Math.hypot(e.x-b.x, e.y-b.y) < e.size+3){
        damageEnemy(e, b.d, { instakill: !!b.instakill, poison: !!b.poison, burn: !!b.burn, color: b.c, n: 5 });
        registerHit();
        if(Math.random() < 0.22) playSfx("hit");

        if(b.explosion) explode(b.x, b.y, b.explosion, b.d*0.8, b.c, { instakill: !!b.instakill });

        if(b.chain){
          // zap nearest other enemy
          let nearest=null, nd=999999;
          for(const e2 of enemies){
            if(e2===e) continue;
            const dd = Math.hypot(e2.x-e.x, e2.y-e.y);
            if(dd<220 && dd<nd){ nd=dd; nearest=e2; }
          }
          if(nearest){
            damageEnemy(nearest, b.d*0.5, { color: b.c, n: 4 });
          }
        }

        if(b.pierce > 0){
          b.pierce--;
          b.hitSet.add(e);
        } else {
          bullets.splice(j,1);
        }
      }
    }

    // enemy bullets hit player
    if(e.type==="boss"){} // handled separately below via bullets loop generic

    if(e.hp <= 0){
      const gainedTable = { boss:250, tank:25, shielded:30, bomber:20, splitter:22, splitling:6, runner:8, shooter:12, normal:10, turret:18, vampire:20 };
      const gained = gainedTable[e.type] ?? 10;
      score += gained * (1 + Math.floor(combo/8)*0.5);
      xp += e.type==="boss" ? 60 : 8;
      pushKillFeed(e.type);
      const deathColor = e.type==="boss" ? (e.bossColor||"#c06bff") : "#ff5a5a";
      spawnParticles(e.x, e.y, deathColor, e.type==="boss"?46:14);
      spawnParticles(e.x, e.y, "#ffffff", e.type==="boss"?12:4);
      shockwaves.push({ x:e.x, y:e.y, radius: e.size*(e.type==="boss"?6:3.2), life:16, maxLife:16, color: deathColor });

      if(e.type === "bomber" && !e.hasExploded){
        e.hasExploded = true;
        explode(e.x, e.y, 110, 42+wave*2, "#ff8a1f", { hitsPlayer:true });
      }
      if(e.type === "splitter" && !e.isSplit){
        for(let s=0;s<2;s++){
          const ang = Math.random()*Math.PI*2;
          const nhp = Math.round((18+wave*2.4)*DIFF.hpMult);
          enemies.push({
            x: e.x+Math.cos(ang)*14, y: e.y+Math.sin(ang)*14, type:"splitling", isSplit:true,
            size:7, hp:nhp, maxHp:nhp, speed: e.speed*1.5, poison:0, hitFlash:0, shootCd:0,
            spawnT:10, spawnMax:10, squash:0, wobble:Math.random()*Math.PI*2, shield:0,
          });
        }
        spawnParticles(e.x, e.y, "#ffcf3d", 10);
      }

      if(e.type==="boss"){
        hp = maxHp; // full regen on boss kill
        shakeAmt = 24;
        hitStopT = 10;
        playSfx("bossKill");
        musicBossMode = enemies.some(o => o.type==="boss" && o!==e);
        showBossReward();
      } else {
        playSfx("kill");
      }
      enemies.splice(i,1);
      killsThisWave++;
    }
  }

  // generic enemy bullets vs player
  for(let i=bullets.length-1;i>=0;i--){
    const b = bullets[i];
    if(!b.enemyBullet) continue;
    if(Math.hypot(b.x-player.x, b.y-player.y) < player.size+3){
      if(invulnT<=0){
        hp -= playerTakeDamage(b.d);
        flashAlpha = Math.min(flashAlpha+0.3,0.5);
        shakeAmt = Math.min(shakeAmt+3,10);
        if(hurtSfxCd<=0){ playSfx("hurt"); hurtSfxCd = 24; }
        if(b.poison) playerPoisonT = 180;
        if(hp<=0 && !gameOverShown){ hp=0; endGame(); }
      }
      bullets.splice(i,1);
    }
  }
  if(hurtSfxCd > 0) hurtSfxCd--;

  // player poison DOT (from toxic enemy attacks, e.g. Plague Mother)
  if(playerPoisonT > 0){
    playerPoisonT--;
    if(playerPoisonT % 20 === 0 && started){
      hp -= playerTakeDamage(2);
      spawnParticles(player.x, player.y, "#69cc4a", 3);
      if(hp<=0 && !gameOverShown){ hp=0; endGame(); }
    }
  }
  document.getElementById("poisonvign").classList.toggle("show", playerPoisonT>0);

  // xp / leveling -> passive power creep
  if(xp >= xpNeed){
    xp -= xpNeed;
    xpNeed = Math.floor(xpNeed*1.18)+6;
    bonusDamage += 0.05;
    maxHp += 4;
    spawnParticles(player.x, player.y, "#2ee6d6", 16);
    playSfx("levelup");
  }

  // fx timers
  for(let i=particles.length-1;i>=0;i--){
    const p = particles[i];
    p.x+=p.dx; p.y+=p.dy; p.dx*=0.94; p.dy*=0.94; p.life--;
    if(p.life<=0) particles.splice(i,1);
  }
  for(let i=slashFx.length-1;i>=0;i--){
    const s = slashFx[i];
    s.radius += (s.maxRadius-s.radius)*0.4;
    s.life--;
    if(s.life<=0) slashFx.splice(i,1);
  }
  for(let i=explosionsFx.length-1;i>=0;i--){
    const ex = explosionsFx[i];
    ex.life--;
    if(ex.life<=0) explosionsFx.splice(i,1);
  }
  for(let i=damageTexts.length-1;i>=0;i--){
    const d = damageTexts[i];
    d.y -= 0.6; d.x += d.drift; d.life--;
    if(d.life<=0) damageTexts.splice(i,1);
  }
  for(let i=telegraphs.length-1;i>=0;i--){
    telegraphs[i].life--;
    if(telegraphs[i].life<=0) telegraphs.splice(i,1);
  }
  for(let i=muzzleFx.length-1;i>=0;i--){
    muzzleFx[i].life--;
    if(muzzleFx[i].life<=0) muzzleFx.splice(i,1);
  }
  for(let i=spawnRings.length-1;i>=0;i--){
    spawnRings[i].life--;
    if(spawnRings[i].life<=0) spawnRings.splice(i,1);
  }
  for(let i=shockwaves.length-1;i>=0;i--){
    shockwaves[i].life--;
    if(shockwaves[i].life<=0) shockwaves.splice(i,1);
  }
  for(let i=playerTrail.length-1;i>=0;i--){
    playerTrail[i].life--;
    if(playerTrail[i].life<=0) playerTrail.splice(i,1);
  }
  if(player.thrust>0) player.thrust -= 0.5;

  if(shakeAmt>0) shakeAmt *= 0.88;
  if(flashAlpha>0) flashAlpha *= 0.9;

  // continuous background spawning for Swarm mode
  if(gameMode === "swarm" && started && !upgradeMode && !soloPicking){
    swarmSpawnCd--;
    if(swarmSpawnCd <= 0){
      swarmSpawnCd = Math.max(9, 28 - wave);
      spawnEnemy();
    }
  }

  // wave clear check
  if(gameMode === "swarm"){
    if(!upgradeMode && !soloPicking && !waveCleared && started && killsThisWave >= 16 + wave*2){
      waveCleared = true;
      playSfx("waveclear");
      if(swarmSoloActive){
        setTimeout(()=>{ if(started) showSwarmSoloWaveBoon(); }, 300);
      } else {
        setTimeout(()=>{ if(started) showUpgrade(); }, 300);
      }
    }
  } else if(enemies.length===0 && !upgradeMode && !waveCleared && started){
    waveCleared = true;
    playSfx("waveclear");
    setTimeout(()=>{ if(started) showUpgrade(); }, 500);
  }

  updateHUD();
}

function updateBoss(e){
  if(e.bossKind === "juggernaut") return updateJuggernaut(e);
  if(e.bossKind === "sniper_lord") return updateSniperLord(e);
  if(e.bossKind === "swarm_queen") return updateSwarmQueen(e);
  if(e.bossKind === "plague_mother") return updatePlagueMother(e);
  if(e.bossKind === "reaper_king") return updateReaperKing(e);
  return updateSentinel(e);
}

// Sentinel: telegraphs, then fires a radial burst ring
function updateSentinel(e){
  e.attackCd--;
  if(e.telegraphT > 0){
    e.telegraphT--;
    if(e.telegraphT === 0){
      const n = 14;
      for(let i=0;i<n;i++){
        const a = (i/n)*Math.PI*2;
        bullets.push({ x:e.x, y:e.y, dx:Math.cos(a)*6, dy:Math.sin(a)*6, d:12, c:"#ff3860", life:160, enemyBullet:true, pierce:0, hitSet:new Set() });
      }
      shakeAmt = Math.min(shakeAmt+8,16);
    }
    return;
  }
  const angle = Math.atan2(player.y-e.y, player.x-e.x);
  e.x += Math.cos(angle)*e.speed;
  e.y += Math.sin(angle)*e.speed;
  if(e.attackCd <= 0){
    e.attackCd = 220;
    e.telegraphT = 45;
    telegraphs.push({ x:e.x, y:e.y, radius: 200, life:45, maxLife:45 });
  }
}

// Juggernaut: telegraphs a charge line, then dashes fast at the player
function updateJuggernaut(e){
  if(e.dashT > 0){
    e.x += Math.cos(e.dashAngle)*e.speed*7;
    e.y += Math.sin(e.dashAngle)*e.speed*7;
    e.dashT--;
    if(e.dashT===0) shakeAmt = Math.min(shakeAmt+10,18);
    return;
  }
  e.attackCd--;
  if(e.telegraphT > 0){
    e.telegraphT--;
    if(e.telegraphT === 0){
      e.dashAngle = Math.atan2(player.y-e.y, player.x-e.x);
      e.dashT = 26;
    }
    return;
  }
  const angle = Math.atan2(player.y-e.y, player.x-e.x);
  e.x += Math.cos(angle)*e.speed;
  e.y += Math.sin(angle)*e.speed;
  if(e.attackCd <= 0){
    e.attackCd = 200;
    e.telegraphT = 40;
    e.dashAngle = Math.atan2(player.y-e.y, player.x-e.x);
    telegraphs.push({ x:e.x, y:e.y, radius: 40, life:40, maxLife:40 });
  }
}

// Sniper Lord: telegraphs a long straight beam toward the player, then fires it
function updateSniperLord(e){
  e.attackCd--;
  if(e.telegraphT > 0){
    e.telegraphT--;
    e.beamAngle = Math.atan2(player.y-e.y, player.x-e.x); // tracks until it fires
    if(e.telegraphT === 0){
      const a = e.beamAngle;
      for(let d=0; d<2400; d+=22){
        bullets.push({ x:e.x+Math.cos(a)*d, y:e.y+Math.sin(a)*d, dx:0, dy:0, d:18, c:"#5adfff", life:10, enemyBullet:true, pierce:0, hitSet:new Set() });
      }
      shakeAmt = Math.min(shakeAmt+10,18);
    }
    return;
  }
  const angle = Math.atan2(player.y-e.y, player.x-e.x);
  e.x += Math.cos(angle)*e.speed*0.6;
  e.y += Math.sin(angle)*e.speed*0.6;
  if(e.attackCd <= 0){
    e.attackCd = 230;
    e.telegraphT = 55;
    e.beamAngle = angle;
  }
}

// Swarm Queen: periodically summons minion adds while slowly approaching
function updateSwarmQueen(e){
  const angle = Math.atan2(player.y-e.y, player.x-e.x);
  e.x += Math.cos(angle)*e.speed;
  e.y += Math.sin(angle)*e.speed;

  e.minionCd--;
  if(e.minionCd <= 0){
    e.minionCd = 210;
    const n = 3;
    for(let i=0;i<n;i++){
      const a = Math.random()*Math.PI*2;
      const spawnX = Math.max(20, Math.min(canvas.width-20, e.x + Math.cos(a)*60));
      const spawnY = Math.max(20, Math.min(canvas.height-20, e.y + Math.sin(a)*60));
      enemies.push({
        x: spawnX, y: spawnY, type: "runner", size: 9,
        hp: (20+wave*3)*DIFF.hpMult, maxHp: (20+wave*3)*DIFF.hpMult, speed: 2.2*DIFF.speedMult, poison:0, hitFlash:0,
        shootCd:0, spawnT:16, spawnMax:16, squash:0, wobble:Math.random()*Math.PI*2, shield:0,
      });
    }
    spawnParticles(e.x, e.y, "#5ec93d", 18);
  }
}

// Plague Mother: releases a slow-expanding ring of toxic projectiles that poison the player
function updatePlagueMother(e){
  e.attackCd--;
  if(e.telegraphT > 0){
    e.telegraphT--;
    if(e.telegraphT === 0){
      const n = 18;
      for(let i=0;i<n;i++){
        const a = (i/n)*Math.PI*2;
        bullets.push({ x:e.x, y:e.y, dx:Math.cos(a)*3.2, dy:Math.sin(a)*3.2, d:6, c:"#8a8f2b", life:260, enemyBullet:true, pierce:0, hitSet:new Set(), poison:true });
      }
      spawnParticles(e.x, e.y, "#8a8f2b", 24);
      shakeAmt = Math.min(shakeAmt+6, 14);
    }
    return;
  }
  const angle = Math.atan2(player.y-e.y, player.x-e.x);
  e.x += Math.cos(angle)*e.speed;
  e.y += Math.sin(angle)*e.speed;
  if(e.attackCd <= 0){
    e.attackCd = 240;
    e.telegraphT = 50;
    telegraphs.push({ x:e.x, y:e.y, radius: 260, life:50, maxLife:50 });
  }
}

// Reaper King: stalks just outside melee range, then teleport-slams the player with a scythe arc
function updateReaperKing(e){
  e.attackCd--;
  if(e.telegraphT > 0){
    e.telegraphT--;
    if(e.telegraphT === 0){
      const dist = Math.hypot(player.x-e.x, player.y-e.y);
      if(dist < 165 && invulnT<=0){
        hp -= playerTakeDamage(14);
        flashAlpha = Math.min(flashAlpha+0.4, 0.6);
        shakeAmt = Math.min(shakeAmt+10, 18);
        if(hurtSfxCd<=0){ playSfx("hurt"); hurtSfxCd = 24; }
        if(hp<=0 && !gameOverShown){ hp=0; endGame(); }
      }
      slashFx.push({ x:e.x, y:e.y, angle: Math.atan2(player.y-e.y, player.x-e.x), radius:40, maxRadius:170, life:16, maxLife:16, color:"#ff2bd6", arc: Math.PI*1.4 });
      spawnParticles(e.x, e.y, "#ff2bd6", 14);
    }
    return;
  }
  const angle = Math.atan2(player.y-e.y, player.x-e.x);
  const dist = Math.hypot(player.x-e.x, player.y-e.y);
  if(dist > 170){ e.x += Math.cos(angle)*e.speed*1.3; e.y += Math.sin(angle)*e.speed*1.3; }
  if(e.attackCd <= 0){
    e.attackCd = 170;
    e.telegraphT = 38;
    telegraphs.push({ x:e.x, y:e.y, radius: 170, life:38, maxLife:38 });
  }
}

function updateHUD(){
  document.getElementById("hpval").innerText = Math.max(0,Math.floor(hp));
  document.getElementById("hpfill").style.width = Math.max(0,(hp/maxHp*100)) + "%";
  const lowHp = hp/maxHp < 0.28;
  document.getElementById("hpfill").classList.toggle("low", lowHp);
  document.getElementById("lowhp").classList.toggle("show", lowHp);
  document.getElementById("xpval").innerText = xp+"/"+xpNeed;
  document.getElementById("xpfill").style.width = Math.min(100, xp/xpNeed*100) + "%";
  document.getElementById("dmgval").innerText = "x" + bonusDamage.toFixed(2);
  document.getElementById("scoreval").innerText = Math.floor(score);
  document.getElementById("combo").innerText = combo>2 ? ("COMBO x"+combo) : "";

  document.getElementById("rowA").classList.toggle("active-slot", activeSlot==="A" && !switching);
  document.getElementById("rowB").classList.toggle("active-slot", activeSlot==="B" && !switching);
  document.getElementById("rowA").classList.toggle("jammed-slot", jammed.A);
  document.getElementById("rowB").classList.toggle("jammed-slot", jammed.B);

  for(const slot of ["A","B"]){
    const key = slot==="A" ? player.weaponA : player.weaponB;
    const ammoEl = document.getElementById("ammoval"+slot);
    const fillEl = document.getElementById("reloadfill"+slot);
    if(!key){ ammoEl.innerText = "-/-"; fillEl.style.width="0%"; continue; }
    const w = weapons[key];
    if(w.melee){ ammoEl.innerText = "MELEE"; fillEl.style.width="100%"; fillEl.style.background="#7dff8a"; continue; }
    if(reloading[slot]){
      const p = Math.min(1, (performance.now()-reloadStart[slot]) / reloadDuration[slot]);
      fillEl.style.width = (p*100)+"%";
      fillEl.style.background = "#ffcf3d";
      ammoEl.innerText = "RELOADING";
    } else if(jammed[slot]){
      fillEl.style.width = "100%";
      fillEl.style.background = "#ff3860";
      ammoEl.innerText = "JAMMED";
    } else {
      fillEl.style.width = (ammo[slot]/w.mag*100)+"%";
      fillEl.style.background = ammo[slot]===0 ? "#ff3860" : "#2ee6d6";
      ammoEl.innerText = ammo[slot]+"/"+w.mag;
    }
  }

  document.getElementById("jammsg").innerText = jamMsgT>0 ? "WEAPON JAMMED — PRESS R" : "";
}

// =========================================================
// DRAW
// =========================================================
function draw(){
  fxctx.setTransform(1,0,0,1,0,0);
  fxctx.clearRect(0,0,fxcanvas.width,fxcanvas.height);
  ctx.setTransform(1,0,0,1,0,0);
  ctx.clearRect(0,0,canvas.width,canvas.height);

  let shakeX=0, shakeY=0;
  if(settings.screenShake && shakeAmt>0.1){
    const t = performance.now()/1000;
    shakeX = Math.sin(t*47.3)*shakeAmt*0.6 + (Math.random()-0.5)*shakeAmt*0.5;
    shakeY = Math.cos(t*61.7)*shakeAmt*0.6 + (Math.random()-0.5)*shakeAmt*0.5;
  }
  ctx.save();
  ctx.translate(shakeX, shakeY);

  // spawn rings (enemy arrival telegraphs)
  for(const r of spawnRings){
    const p = 1 - r.life/r.maxLife;
    ctx.globalAlpha = 1-p;
    ctx.strokeStyle = r.color;
    ctx.lineWidth = r.big ? 4 : 2;
    ctx.shadowColor = r.color; ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.arc(r.x, r.y, (r.big?70:34)*p, 0, Math.PI*2);
    ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.globalAlpha = 1;
  }

  // telegraphs (ground warning rings) — pulsing double ring w/ rotating dashes
  for(const t of telegraphs){
    const p = 1 - t.life/t.maxLife;
    const pulse = 1 + Math.sin(t.life*0.6)*0.03;
    ctx.strokeStyle = `rgba(255,56,96,${0.25+p*0.55})`;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(t.x, t.y, t.radius*pulse, 0, Math.PI*2);
    ctx.stroke();
    ctx.setLineDash([14,10]);
    ctx.lineDashOffset = -performance.now()/25;
    ctx.strokeStyle = `rgba(255,120,140,${0.4+p*0.4})`;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(t.x, t.y, t.radius*0.92*pulse, 0, Math.PI*2);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = `rgba(255,56,96,${0.05+p*0.08})`;
    ctx.beginPath();
    ctx.arc(t.x, t.y, t.radius*pulse, 0, Math.PI*2);
    ctx.fill();
  }

  // dash afterimages
  for(const tr of playerTrail){
    const p = tr.life/tr.maxLife;
    ctx.save();
    ctx.globalAlpha = p*0.35;
    ctx.translate(tr.x, tr.y);
    ctx.rotate(tr.angle);
    ctx.fillStyle = "#2ee6d6";
    ctx.beginPath();
    ctx.moveTo(player.size+6, 0);
    ctx.lineTo(-player.size*0.7, player.size*0.8);
    ctx.lineTo(-player.size*0.3, 0);
    ctx.lineTo(-player.size*0.7, -player.size*0.8);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha = 1;

  // player
  if(started){
    const angle = player.facingAngle;
    const invuln = invulnT>0;
    ctx.globalAlpha = invuln ? 0.5+0.3*Math.sin(performance.now()/30) : 1;

    const bobY = Math.sin(player.bob)*1.6;
    const thrustLen = 6 + Math.sin(performance.now()/40)*2 + player.thrust*1.5;

    // thruster glow
    ctx.fillStyle = "rgba(46,230,214,0.15)";
    ctx.beginPath();
    ctx.arc(player.x, player.y+bobY, player.size+8, 0, Math.PI*2);
    ctx.fill();

    ctx.save();
    ctx.translate(player.x, player.y+bobY);
    ctx.rotate(angle);
    ctx.rotate(player.bank*0.4);
    if(switching){
      const swp = 1 - switchT/22;
      const flip = Math.cos(swp*Math.PI);
      ctx.scale(1, flip);
    }

    // engine flame (flickers, extends w/ thrust)
    ctx.save();
    ctx.globalAlpha *= 0.85;
    const flameGrad = ctx.createLinearGradient(-player.size*0.3,0,-player.size*0.3-thrustLen,0);
    flameGrad.addColorStop(0, "#ffe066");
    flameGrad.addColorStop(1, "rgba(255,56,96,0)");
    ctx.fillStyle = flameGrad;
    ctx.beginPath();
    ctx.moveTo(-player.size*0.3, -3.5);
    ctx.lineTo(-player.size*0.3-thrustLen, 0);
    ctx.lineTo(-player.size*0.3, 3.5);
    ctx.closePath();
    ctx.fill();
    ctx.restore();

    ctx.fillStyle = "#2ee6d6";
    ctx.shadowColor = "#2ee6d6"; ctx.shadowBlur = dashActiveT>0 ? 20 : 6;
    ctx.beginPath();
    ctx.moveTo(player.size+6, 0);
    ctx.lineTo(-player.size*0.7, player.size*0.8);
    ctx.lineTo(-player.size*0.3, 0);
    ctx.lineTo(-player.size*0.7, -player.size*0.8);
    ctx.closePath();
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 1.4;
    ctx.stroke();
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  // muzzle flashes
  for(const m of muzzleFx){
    const p = m.life/m.maxLife;
    ctx.save();
    ctx.translate(m.x, m.y);
    ctx.rotate(m.angle);
    ctx.globalAlpha = p;
    ctx.fillStyle = "#ffffff";
    ctx.shadowColor = m.color; ctx.shadowBlur = 14;
    const len = (m.big?22:12)*p + 4;
    ctx.beginPath();
    ctx.moveTo(0,0);
    ctx.lineTo(len, -4*p);
    ctx.lineTo(len*1.3, 0);
    ctx.lineTo(len, 4*p);
    ctx.closePath();
    ctx.fill();
    ctx.shadowBlur = 0;
    if(m.energy){
      ctx.strokeStyle = m.color;
      ctx.globalAlpha = p*0.7;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(0, 0, 8*p+3, 0, Math.PI*2);
      ctx.stroke();
    }
    ctx.restore();
  }
  ctx.globalAlpha = 1;

  // bullets (with motion trails, styled per weapon type)
  for(const b of bullets){
    const t = b.wtype;
    if(b.px !== undefined){
      if(t === "Precision"){
        // thin bright long tracer with white-hot core
        ctx.strokeStyle = b.c;
        ctx.globalAlpha = 0.85;
        ctx.lineWidth = 1.6;
        ctx.shadowColor = b.c; ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.moveTo(b.px - b.dx*3, b.py - b.dy*3);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
        ctx.strokeStyle = "#ffffff";
        ctx.globalAlpha = 0.6; ctx.lineWidth = 0.8;
        ctx.beginPath(); ctx.moveTo(b.px, b.py); ctx.lineTo(b.x, b.y); ctx.stroke();
        ctx.shadowBlur = 0;
      } else if(t === "Energy" || t === "Singularity"){
        // pulsing glow trail
        const pulse = 1 + Math.sin(performance.now()/60 + b.x*0.1)*0.25;
        ctx.strokeStyle = b.c;
        ctx.globalAlpha = 0.55;
        ctx.lineWidth = (t==="Singularity"?4:2.6) * pulse;
        ctx.shadowColor = b.c; ctx.shadowBlur = t==="Singularity"?18:10;
        ctx.beginPath();
        ctx.moveTo(b.px, b.py);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
        ctx.shadowBlur = 0;
      } else {
        ctx.strokeStyle = b.c;
        ctx.globalAlpha = 0.5;
        ctx.lineWidth = b.enemyBullet ? 3 : 2.4;
        ctx.beginPath();
        ctx.moveTo(b.px, b.py);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }
    ctx.fillStyle = b.instakill ? "#ffffff" : b.c;
    ctx.shadowColor = b.instakill ? "#ff2bd6" : b.c;
    ctx.shadowBlur = b.instakill ? 20 : (t==="Singularity" ? 16 : 8);
    ctx.beginPath();
    const bulletR = b.instakill ? 6.5 : (t==="Singularity" ? 6 : (b.enemyBullet?4:3.4));
    ctx.arc(b.x, b.y, bulletR, 0, Math.PI*2);
    ctx.fill();
    ctx.shadowBlur = 0;
  }

  // enemies
  for(const e of enemies){
    const flash = e.hitFlash>0;
    let baseColor = e.type==="boss" ? (e.bossColor||"#c06bff") : (ENEMY_COLOR[e.type] || "#ff3860");

    // spawn-in scale/fade
    const spawnP = e.spawnT>0 ? 1 - e.spawnT/e.spawnMax : 1;
    const spawnScale = e.spawnT>0 ? (0.2 + 0.8*easeOutBack(spawnP)) : 1;

    // squash/stretch pulse from hits + idle wobble
    const sq = Math.max(0, e.squash);
    const wob = e.type==="boss" ? 0 : Math.sin(e.wobble)*0.05;
    const scaleX = spawnScale * (1 - sq*0.25 + wob);
    const scaleY = spawnScale * (1 + sq*0.25 - wob);

    ctx.save();
    ctx.translate(e.x, e.y);
    ctx.scale(scaleX, scaleY);
    ctx.globalAlpha = e.spawnT>0 ? Math.min(1, spawnP*1.6) : 1;

    ctx.fillStyle = flash ? "#ffffff" : baseColor;
    ctx.shadowColor = baseColor;
    ctx.shadowBlur = e.type==="boss" ? (16+Math.sin(performance.now()/150)*6) : 6;
    ctx.beginPath();
    ctx.arc(0, 0, e.size, 0, Math.PI*2);
    ctx.fill();
    ctx.shadowBlur = 0;

    if(e.poison>0){
      ctx.strokeStyle = "rgba(105,204,74,0.7)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(0, 0, e.size+4+Math.sin(performance.now()/100)*1.5, 0, Math.PI*2);
      ctx.stroke();
    }
    if(e.shield > 0){
      const shp = e.shield/e.maxShield;
      ctx.strokeStyle = `rgba(90,223,255,${0.5+shp*0.4})`;
      ctx.lineWidth = 2.4;
      ctx.shadowColor = "#5adfff"; ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.arc(0, 0, e.size+6, 0, Math.PI*2*shp);
      ctx.stroke();
      ctx.shadowBlur = 0;
    }
    if(e.type === "bomber"){
      const dp = Math.hypot(player.x-e.x, player.y-e.y);
      const near = dp < 140;
      const pulse = near ? (0.4+0.6*Math.abs(Math.sin(performance.now()/70))) : (0.3+0.3*Math.abs(Math.sin(performance.now()/280)));
      ctx.strokeStyle = `rgba(255,90,31,${pulse})`;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(0, 0, e.size+3, 0, Math.PI*2);
      ctx.stroke();
    }
    ctx.restore();
    ctx.globalAlpha = 1;

    // hp bar
    if(e.spawnT<=0){
      const w = e.size*2.2;
      const pct = Math.max(0, e.hp/e.maxHp);
      ctx.fillStyle = "rgba(0,0,0,0.5)";
      ctx.fillRect(e.x-w/2, e.y-e.size-12, w, 4);
      ctx.fillStyle = pct>0.5 ? "#7dff8a" : pct>0.2 ? "#ffcf3d" : "#ff3860";
      ctx.fillRect(e.x-w/2, e.y-e.size-12, w*pct, 4);
      if(e.shield > 0){
        ctx.fillStyle = "rgba(90,223,255,0.85)";
        ctx.fillRect(e.x-w/2, e.y-e.size-17, w*(e.shield/e.maxShield), 3);
      }
    }
  }

  // slash fx (with fading afterimage arcs for swipe motion)
  for(const s of slashFx){
    const lifeP = s.life/s.maxLife;
    const thickMul = s.thick ? 1.8 : 1;
    for(let k=0;k<3;k++){
      const off = k*0.09;
      ctx.globalAlpha = lifeP * (1-k*0.32);
      ctx.strokeStyle = s.thick ? "#ffffff" : s.color;
      ctx.lineWidth = (5-k*1.3) * thickMul;
      ctx.shadowColor = s.color;
      ctx.shadowBlur = (12-k*3) * (s.thick ? 1.6 : 1);
      ctx.beginPath();
      if(s.arc >= Math.PI*1.9){
        ctx.arc(s.x, s.y, s.radius*(1-off*0.15), 0, Math.PI*2);
      } else {
        ctx.arc(s.x, s.y, s.radius*(1-off*0.15), s.angle-s.arc/2-off, s.angle+s.arc/2-off);
      }
      ctx.stroke();
    }
    ctx.shadowBlur = 0;
    ctx.globalAlpha = 1;
  }

  // shockwave rings (explosions + kills)
  for(const sw of shockwaves){
    const p = 1 - sw.life/sw.maxLife;
    ctx.globalAlpha = (1-p)*0.8;
    ctx.strokeStyle = sw.color;
    ctx.lineWidth = 3*(1-p)+1;
    ctx.shadowColor = sw.color; ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.arc(sw.x, sw.y, sw.radius*easeOutQuad(p), 0, Math.PI*2);
    ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.globalAlpha = 1;
  }

  // explosions
  for(const ex of explosionsFx){
    const p = ex.life/ex.maxLife;
    ctx.globalAlpha = p*0.8;
    const grad = ctx.createRadialGradient(ex.x,ex.y,0,ex.x,ex.y,ex.radius*(1-p*0.3));
    grad.addColorStop(0, ex.color);
    grad.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(ex.x, ex.y, ex.radius*(1-p*0.3), 0, Math.PI*2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  // particles (with subtle glow + trail stretch)
  for(const p of particles){
    const lifeP = Math.max(0,p.life/p.maxLife);
    ctx.globalAlpha = lifeP;
    ctx.fillStyle = p.color;
    ctx.shadowColor = p.color; ctx.shadowBlur = 4;
    const stretch = Math.min(1.8, Math.hypot(p.dx,p.dy)*0.25);
    ctx.save();
    ctx.translate(p.x,p.y);
    ctx.rotate(Math.atan2(p.dy,p.dx));
    ctx.fillRect(-p.size/2*stretch, -p.size/2, p.size*stretch, p.size);
    ctx.restore();
    ctx.shadowBlur = 0;
    ctx.globalAlpha = 1;
  }

  // damage numbers (pop-in scale + upward drift)
  if(settings.damageNumbers){
    ctx.textAlign = "center";
    for(const d of damageTexts){
      const age = 40 - d.life;
      const pop = age < 8 ? easeOutBack(age/8) : 1;
      ctx.save();
      ctx.translate(d.x, d.y);
      ctx.scale(pop, pop);
      ctx.font = (d.crit ? "bold 17px Courier New" : "bold 13px Courier New");
      ctx.globalAlpha = Math.max(0, d.life/40);
      ctx.fillStyle = d.crit ? "#ffcf3d" : "#ffffff";
      ctx.fillText(d.val, 0, 0);
      ctx.restore();
      ctx.globalAlpha = 1;
    }
  }

  ctx.restore();

  // screen flash (damage taken)
  if(settings.screenFlash && flashAlpha > 0.01){
    ctx.fillStyle = `rgba(255,30,60,${flashAlpha})`;
    ctx.fillRect(0,0,canvas.width,canvas.height);
  }

  drawMinimap();
}

function drawMinimap(){
  if(!settings.showMinimap){ mmctx.clearRect(0,0,MM_SIZE,MM_SIZE); return; }
  mmctx.clearRect(0,0,MM_SIZE,MM_SIZE);
  if(!started) return;
  mmctx.fillStyle = "rgba(255,255,255,0.04)";
  mmctx.fillRect(0,0,MM_SIZE,MM_SIZE);
  const sx = MM_SIZE/canvas.width, sy = MM_SIZE/canvas.height;
  const pulse = 1 + Math.sin(performance.now()/200)*0.25;
  mmctx.fillStyle = "#2ee6d6";
  mmctx.shadowColor = "#2ee6d6"; mmctx.shadowBlur = 4;
  mmctx.beginPath();
  mmctx.arc(player.x*sx, player.y*sy, 4*pulse, 0, Math.PI*2);
  mmctx.fill();
  mmctx.shadowBlur = 0;
  for(const e of enemies){
    mmctx.fillStyle = e.type==="boss" ? (e.bossColor||"#c06bff") : (ENEMY_COLOR[e.type] || "#ff3860");
    const r = e.type==="boss" ? 4*pulse : 2;
    mmctx.beginPath();
    mmctx.arc(e.x*sx, e.y*sy, r, 0, Math.PI*2);
    mmctx.fill();
  }
}

// =========================================================
// GAMEPAD (PS4/PS5 + Xbox — standard mapping)
// =========================================================
let gpIndex = null;
let gpPrevButtons = {};
let gpPrevStick = { left:false, right:false };
let gpDisabled = false;
const GP_DEADZONE = 0.18;

addEventListener("gamepadconnected", e=>{ gpIndex = e.gamepad.index; });
addEventListener("gamepaddisconnected", e=>{ if(gpIndex===e.gamepad.index) gpIndex = null; });

function pollGamepad(){
  if(gpDisabled) return;
  let pads;
  try{
    pads = navigator.getGamepads ? navigator.getGamepads() : [];
  } catch(err){
    // gamepad access blocked by permissions policy (e.g. sandboxed iframe) — disable silently
    gpDisabled = true;
    return;
  }
  let gp = gpIndex!==null ? pads[gpIndex] : null;
  if(!gp){
    for(const p of pads){ if(p){ gp = p; gpIndex = p.index; break; } }
  }
  if(!gp) return;

  const wasDown = k => !!gpPrevButtons[k];
  const btn = i => gp.buttons[i] && gp.buttons[i].pressed;
  const btnVal = i => gp.buttons[i] ? gp.buttons[i].value : 0;

  // left stick -> movement
  let lx = gp.axes[0]||0, ly = gp.axes[1]||0;
  if(Math.hypot(lx,ly) < GP_DEADZONE){ lx=0; ly=0; }
  gpMove.x = lx; gpMove.y = ly;

  // right stick -> aim
  let rx = gp.axes[2]||0, ry = gp.axes[3]||0;
  if(Math.hypot(rx,ry) > GP_DEADZONE){
    gpAim.active = true;
    gpAim.x = rx; gpAim.y = ry;
  } else {
    gpAim.active = false;
  }

  // menu / game-over screen — A or Start begins a run
  if(!started){
    if((btn(0) && !wasDown(0)) || (btn(9) && !wasDown(9))) startGame();
    gpPrevButtons = {};
    for(let i=0;i<gp.buttons.length;i++) gpPrevButtons[i] = btn(i);
    return;
  }

  // Start / Options button (index 9) toggles pause
  if(btn(9) && !wasDown(9) && !soloPicking){
    togglePause();
    gpPrevButtons = {};
    for(let i=0;i<gp.buttons.length;i++) gpPrevButtons[i] = btn(i);
    return;
  }
  if(paused || soloPicking){
    gpPrevButtons = {};
    for(let i=0;i<gp.buttons.length;i++) gpPrevButtons[i] = btn(i);
    return;
  }

  // right trigger (R2 on PS / RT on Xbox, index 7) -> fire
  const firing = btnVal(7) > 0.15 || btn(7);
  if(firing && !upgradeMode) fire();

  // A / Cross (index 0) -> dash
  if(btn(0) && !wasDown(0)) tryDash();

  // bumpers (LB/L1 index 4, RB/R1 index 5) -> switch weapon
  if((btn(4) && !wasDown(4)) || (btn(5) && !wasDown(5))) switchSlot();

  // D-pad up/down (index 12/13) -> cycle Swarm arsenal, unused elsewhere during normal play
  if(btn(12) && !wasDown(12)) cycleArsenal(-1);
  if(btn(13) && !wasDown(13)) cycleArsenal(1);

  // upgrade screen — D-pad / left stick to move focus, A / Cross to confirm
  if(upgradeMode){
    const count = bossReward ? bossBoons.length : choices.length;
    const dpadLeft = btn(14), dpadRight = btn(15);
    const stickLeft = lx < -0.5, stickRight = lx > 0.5;
    if((dpadLeft && !wasDown(14)) || (stickLeft && !gpPrevStick.left)){
      gpFocusIndex = (gpFocusIndex - 1 + count) % count;
      updateGpFocusHighlight();
    }
    if((dpadRight && !wasDown(15)) || (stickRight && !gpPrevStick.right)){
      gpFocusIndex = (gpFocusIndex + 1) % count;
      updateGpFocusHighlight();
    }
    gpPrevStick.left = stickLeft; gpPrevStick.right = stickRight;

    if(btn(0) && !wasDown(0)){
      if(bossReward) pickBossReward(gpFocusIndex); else pickWeapon(gpFocusIndex);
    }
  }

  gpPrevButtons = {};
  for(let i=0;i<gp.buttons.length;i++) gpPrevButtons[i] = btn(i);
}

// =========================================================
// MAIN LOOP
// =========================================================
let lastT = performance.now();
function loop(t){
  const dt = Math.min(2, (t-lastT)/16.67);
  lastT = t;
  pollGamepad();
  drawBg();
  if(!paused){
    if(hitStopT > 0){ hitStopT--; } else { update(dt); }
  }
  draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>
