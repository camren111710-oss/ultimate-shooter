  }
  #settingspanel .opt-title{
    font-size:11px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;margin-bottom:8px;
  }
  #settingspanel .opt-row{
    display:flex;align-items:center;gap:9px;font-size:12.5px;letter-spacing:.5px;
    padding:5px 0;cursor:pointer;color:var(--text);
  }
  #settingspanel .opt-row input{
    width:15px;height:15px;accent-color:var(--accent2);cursor:pointer;
  }
  #settingspanel .opt-volume-row{
    justify-content:space-between;cursor:default;padding-bottom:10px;margin-bottom:6px;
