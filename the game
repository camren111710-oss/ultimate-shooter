const DEFAULT_RELOAD = { Sidearm:900, Auto:1300, Spread:1700, Precision:1800, Explosive:2000, Energy:1150, Melee:0, Burst:1000, Toxic:1200, Flame:1400, Boomerang:1900 };
for(const key of Object.keys(weapons)){
