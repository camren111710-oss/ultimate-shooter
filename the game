function weaponStatLines(w){
  const lines = [];
  if(w.instakill){
    lines.push(["Effect", "INSTANT KILL"]);
    lines.push([w.melee?"Reach":"Range", w.range]);
    lines.push(["Speed", (1000/w.cd).toFixed(1)+"/s"]);
    return lines;
  }
  if(w.melee){
    lines.push(["Damage", Math.round(w.d*RARITY[w.rarity])]);
    lines.push(["Reach", w.range]);
    lines.push(["Speed", (1000/w.cd).toFixed(1)+"/s"]);
  } else {
    lines.push(["Damage", Math.round(w.d*RARITY[w.rarity])]);
    lines.push(["Fire rate", (1000/w.cd).toFixed(1)+"/s"]);
    if(w.pellets) lines.push(["Pellets", w.pellets]);
    if(w.pierce) lines.push(["Pierce", w.pierce]);
    if(w.explosion) lines.push(["Blast", w.explosion]);
  }
  return lines;
}

function updateGpFocusHighlight(){
  const container = document.getElementById("choices");
  const cards = container.children;
  for(let i=0;i<cards.length;i++){
    cards[i].classList.toggle("gp-focus", i===gpFocusIndex);
  }
}

function showUpgrade(){
  upgradeMode = true;
  choices = [];
  gpFocusIndex = 0;

  const titleEl = document.getElementById("upgradeTitle");
  if(gameMode === "swarm"){
    titleEl.innerText = "ADD TO YOUR ARSENAL — YOU KEEP EVERY WEAPON YOU PICK";
  } else if(player.weaponB === null){
    titleEl.innerText = "PICK YOUR SECOND WEAPON";
  } else {
    titleEl.innerText = "REPLACE SLOT " + (replaceToggle===0 ? "1" : "2") + " WEAPON";
  }
  // weighted pick: higher waves bias toward better rarities, but keep variety
  // secret-tier weapons are excluded from the normal pool — they're injected separately, extremely rarely
  const pool = weaponKeys.filter(k =>
    k !== player.weaponA && k !== player.weaponB && weapons[k].rarity !== "secret" &&
    (gameMode !== "swarm" || !swarmArsenal.includes(k))
  );
  while(choices.length < 3 && choices.length < pool.length){
    const w = pool[Math.floor(Math.random()*pool.length)];
    if(!choices.includes(w)) choices.push(w);
  }

  // ULTRA-RARE: tiny chance to swap one choice for a secret instakill weapon (never earlier than wave 8)
  let gotSecret = false;
  if(wave >= 8 && Math.random() < 0.012){
    const secretKeys = weaponKeys.filter(k => weapons[k].rarity === "secret" && k !== player.weaponA && k !== player.weaponB);
    if(secretKeys.length){
      const pick = secretKeys[Math.floor(Math.random()*secretKeys.length)];
      choices[Math.floor(Math.random()*choices.length)] = pick;
      gotSecret = true;
    }
  }

  const container = document.getElementById("choices");
  container.innerHTML = "";
  choices.forEach((key, i) => {
    const w = weapons[key];
    const div = document.createElement("div");
    div.className = "choice" + (w.rarity==="secret" ? " secret-card" : "");
    div.onclick = () => pickWeapon(i);
    const statLines = weaponStatLines(w).map(([label,val]) =>
      `<div>${label}<b>${val}</b></div>`
    ).join("");
    div.innerHTML = `
      <div class="rk ${w.rarity}">${w.rarity.toUpperCase()}</div>
      <div class="num">${i+1}</div>
      <div class="wname" style="color:${w.c}">${w.displayName}</div>
      <div class="wtype">${w.type}</div>
      <div class="wstats">${statLines}</div>
    `;
    container.appendChild(div);
  });

  document.getElementById("upgrade").style.display = "flex";
  updateGpFocusHighlight();
  if(gotSecret){ playSfx("secretDrop"); flashWaveMsg("!! A SECRET WEAPON HAS APPEARED !!"); }
}

function pickWeapon(i){
  const picked = choices[i];

  if(gameMode === "swarm" && !swarmArsenal.includes(picked)) swarmArsenal.push(picked);

  if(player.weaponB === null){
    player.weaponB = picked;
    lastShotB = 0;
    ammo.B = weapons[picked].mag;
    reloading.B = false; jammed.B = false;
  } else if(player.weaponA === null){
    player.weaponA = picked;
    lastShotA = 0;
    ammo.A = weapons[picked].mag;
    reloading.A = false; jammed.A = false;
  } else {
    // both slots full — overwrite alternating slot
    // (in Swarm mode nothing is truly lost — the outgoing weapon stays in your arsenal below)
    if(replaceToggle === 0){
      player.weaponA = picked; lastShotA = 0;
      ammo.A = weapons[picked].mag; reloading.A = false; jammed.A = false;
    } else {
      player.weaponB = picked; lastShotB = 0;
      ammo.B = weapons[picked].mag; reloading.B = false; jammed.B = false;
    }
    replaceToggle = 1 - replaceToggle;
  }

  document.getElementById("weaponnameA").innerText = player.weaponA ? weapons[player.weaponA].displayName : "— empty —";
  document.getElementById("weaponnameB").innerText = player.weaponB ? weapons[player.weaponB].displayName : "— empty —";
  document.getElementById("upgrade").style.display = "none";
  upgradeMode = false;
  wave++;
  document.getElementById("waveval").innerText = wave;
  flashWaveMsg("WAVE " + wave);
  renderSwarmArsenal();
  spawnWave();
}

// =========================================================
// SWARM ARSENAL — every weapon picked in Swarm mode is kept permanently;
// cycle any of them back into your active slot at any time.
// =========================================================
function equipFromArsenal(key){
  if(gameMode !== "swarm" || !started || upgradeMode || switching || soloPicking) return;
  if(!weapons[key]) return;
  const slot = activeSlot;
  if(slot === "A"){ player.weaponA = key; lastShotA = 0; ammo.A = weapons[key].mag; reloading.A = false; jammed.A = false; }
  else { player.weaponB = key; lastShotB = 0; ammo.B = weapons[key].mag; reloading.B = false; jammed.B = false; }
  document.getElementById("weaponnameA").innerText = player.weaponA ? weapons[player.weaponA].displayName : "— empty —";
  document.getElementById("weaponnameB").innerText = player.weaponB ? weapons[player.weaponB].displayName : "— empty —";
  playSfx("reload");
  renderSwarmArsenal();
}
function cycleArsenal(dir){
  if(gameMode !== "swarm" || !started || upgradeMode || soloPicking || swarmArsenal.length < 2) return;
  const current = activeSlot === "A" ? player.weaponA : player.weaponB;
  let idx = swarmArsenal.indexOf(current);
  if(idx === -1) idx = 0;
  idx = (idx + dir + swarmArsenal.length) % swarmArsenal.length;
  equipFromArsenal(swarmArsenal[idx]);
}
function renderSwarmArsenal(){
  const box = document.getElementById("swarmarsenal");
  if(!box) return;
  if(gameMode !== "swarm" || !started || swarmArsenal.length === 0){
    box.classList.add("hidden");
    box.innerHTML = "";
    return;
  }
  box.classList.remove("hidden");
  let html = "";
  for(const key of swarmArsenal){
    const w = weapons[key];
    const equipped = key === player.weaponA || key === player.weaponB;
    html += `<div class="arsenal-pill${equipped?" equipped":""}" style="border-color:${w.c}" onclick="equipFromArsenal('${key}')" title="${w.displayName}">${w.displayName}</div>`;
  }
  box.innerHTML = html;
}

