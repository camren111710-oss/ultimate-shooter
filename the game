function drawBg(){
  bgTime += 1;
  bgctx.fillStyle = "#05060a";
  bgctx.fillRect(0,0,bgcanvas.width,bgcanvas.height);

  // drifting nebula blobs
  for(const n of nebulae){
    n.x += n.driftX; n.y += n.driftY;
    if(n.x < -n.r) n.x = bgcanvas.width+n.r;
    if(n.x > bgcanvas.width+n.r) n.x = -n.r;
    if(n.y < -n.r) n.y = bgcanvas.height+n.r;
    if(n.y > bgcanvas.height+n.r) n.y = -n.r;
    const grad = bgctx.createRadialGradient(n.x,n.y,0,n.x,n.y,n.r);
    grad.addColorStop(0, n.c);
    grad.addColorStop(1, "rgba(0,0,0,0)");
    bgctx.fillStyle = grad;
    bgctx.beginPath();
    bgctx.arc(n.x,n.y,n.r,0,Math.PI*2);
    bgctx.fill();
  }

  // subtle grid
  bgctx.strokeStyle = "rgba(255,255,255,0.025)";
  bgctx.lineWidth = 1;
  const g = 60;
  for(let x=0;x<bgcanvas.width;x+=g){
    bgctx.beginPath(); bgctx.moveTo(x,0); bgctx.lineTo(x,bgcanvas.height); bgctx.stroke();
  }
  for(let y=0;y<bgcanvas.height;y+=g){
    bgctx.beginPath(); bgctx.moveTo(0,y); bgctx.lineTo(bgcanvas.width,y); bgctx.stroke();
  }

  // stars w/ twinkle + parallax drift based on player movement
  const driftX = started ? -player.vx*0.4 : 0;
  const driftY = started ? -player.vy*0.4 : 0;
  for(const s of stars){
    s.tw += s.twSpd;
    s.x += driftX * s.z * 0.02;
    s.y += driftY * s.z * 0.02;
    if(s.x < 0) s.x += bgcanvas.width; if(s.x > bgcanvas.width) s.x -= bgcanvas.width;
    if(s.y < 0) s.y += bgcanvas.height; if(s.y > bgcanvas.height) s.y -= bgcanvas.height;
    bgctx.globalAlpha = (0.4 + s.z*0.2) * (0.6+0.4*Math.sin(s.tw));
    bgctx.fillStyle = "#ffffff";
    bgctx.beginPath();
    bgctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
    bgctx.fill();
  }
  bgctx.globalAlpha = 1;

  // dash speed-lines
  if(started && dashActiveT > 0){
    const a = Math.atan2(player.vy, player.vx);
    bgctx.strokeStyle = "rgba(46,230,214,0.18)";
    bgctx.lineWidth = 2;
    for(let i=0;i<14;i++){
      const rx = Math.random()*bgcanvas.width, ry = Math.random()*bgcanvas.height;
      const len = 40+Math.random()*70;
      bgctx.beginPath();
      bgctx.moveTo(rx,ry);
      bgctx.lineTo(rx-Math.cos(a)*len, ry-Math.sin(a)*len);
      bgctx.stroke();
    }
  }

  // vignette
  const grad = bgctx.createRadialGradient(
    bgcanvas.width/2, bgcanvas.height/2, bgcanvas.height*0.2,
    bgcanvas.width/2, bgcanvas.height/2, bgcanvas.height*0.75
  );
  grad.addColorStop(0,"rgba(0,0,0,0)");
  grad.addColorStop(1,"rgba(0,0,0,0.55)");
  bgctx.fillStyle = grad;
  bgctx.fillRect(0,0,bgcanvas.width,bgcanvas.height);
}
