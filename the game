  { fam:"Tesla Coil", type:"Energy",    d:[8,16],  cd:[160,240], spd:[15,19], range:[850,1150], mag:[14,22], reload:[1100,1500] },
  { fam:"Whip",     type:"Melee", melee:true, d:[18,32],  range:[170,220], cd:[260,340] },
];

const PREFIXES = [
  "Rusty","Standard","Sharp","Heavy","Rapid","Blazing","Frozen","Venomous","Cursed","Holy",
  "Shadow","Solar","Lunar","Storm","Quantum","Void","Chrome","Golden","Crimson","Emerald",
  "Obsidian","Plasma","Nano","Ancient","Prototype","Overclocked","Molten","Glacial","Toxic","Radiant",
  "Phantom","Savage","Feral","Royal","Imperial","Cosmic","Nuclear","Celestial","Infernal","Ethereal",
  "Diamond","Titan","Mecha","Cyber","Dark","Wild","Primal","Elder","Astral","Vengeful",
  "Frostbitten","Sunforged","Abyssal","Corrupted","Blessed","Rune-Etched","Volcanic","Glacier","Thunderous","Silent",
  "Feathered","Ironclad","Spectral","Draconic","Meteoric",
];
// higher index = stronger multiplier + better odds at rare rarity
function prefixTier(i){ return i / PREFIXES.length; }

function seededColorFor(fam, prefixIdx){
  const palette = ["#ffe066","#5ad1ff","#7dff8a","#ff9d3d","#c06bff","#ff5a5a","#4da6ff","#e8e8ff","#ff5adf","#9aa3b5","#5ec93d","#ffcf3d"];
  return palette[(prefixIdx*7 + fam.fam.length) % palette.length];
}

function rollRarity(prefixIdx){
  const t = prefixTier(prefixIdx) + Math.random()*0.4;
  if(t > 1.05) return "mythic";
  if(t > 0.82) return "legendary";
  if(t > 0.55) return "epic";
  if(t > 0.28) return "rare";
  return "common";
}

function rand(range){ return range[0] + Math.random()*(range[1]-range[0]); }

function jamChanceFor(rarity){
  return { common:0.08, rare:0.06, epic:0.04, legendary:0.02, mythic:0.005, secret:0 }[rarity];
}

function generateProceduralWeapons(targetTotal){
  const combos = [];
  for(const fam of FAMILIES){
    for(let p=0;p<PREFIXES.length;p++){
      combos.push({ fam, p });
    }
  }
  // shuffle for variety
  for(let i=combos.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [combos[i],combos[j]] = [combos[j],combos[i]];
  }
  const need = Math.max(0, targetTotal - Object.keys(weapons).length);
  const count = Math.min(need, combos.length);

  for(let i=0;i<count;i++){
    const { fam, p } = combos[i];
    const prefix = PREFIXES[p];
    const rarity = rollRarity(p);
    const mult = 0.85 + prefixTier(p)*0.6;
    const key = (prefix+"_"+fam.fam).toLowerCase().replace(/[^a-z0-9]+/g,"_") + "_" + i;
    const w = {
      d: +(rand(fam.d)*mult).toFixed(1),
      cd: Math.round(rand(fam.cd) / (0.9+prefixTier(p)*0.3)),
      range: Math.round(rand(fam.range)),
      c: seededColorFor(fam, p),
      type: fam.type,
      rarity,
      displayName: prefix + " " + fam.fam,
      mag: fam.melee ? 0 : Math.round(rand(fam.mag)),
      reload: fam.melee ? 0 : Math.round(rand(fam.reload)),
      jamChance: fam.melee ? 0 : jamChanceFor(rarity),
    };
    if(fam.melee){
      w.melee = true;
      w.range = Math.round(rand(fam.range));
      if(fam.aoeChance && Math.random()<fam.aoeChance) w.aoe = true;
      if(fam.poisonChance && Math.random()<fam.poisonChance) w.poison = true;
    } else {
      w.spd = +rand(fam.spd || [10,14]).toFixed(1);
      if(fam.pellets) w.pellets = Math.round(rand(fam.pellets));
      if(fam.spread) w.spread = Math.round(rand(fam.spread));
      if(fam.pierce && Math.random()<0.6) w.pierce = Math.round(rand(fam.pierce));
      if(fam.explosion) w.explosion = Math.round(rand(fam.explosion));
      if(Math.random()<0.06) w.poison = true;
      if(Math.random()<0.04) w.chain = true;
    }
    weapons[key] = w;
  }
}
generateProceduralWeapons(950);

