  </div>
</div>

<!-- ACHIEVEMENT TOASTS -->
<div id="achtoasts"></div>

<script>
"use strict";

/* =====================================================================
   ULTIMATE SHOOTER — OVERDRIVE EDITION
   Rebuilt on top of the original wave-shooter concept:
   - mouse/touch aim + free 8-dir movement + auto/held fire
   - dedup'd, rebalanced weapon roster with rarity tiers
   - particles, screen shake, hit-flash, muzzle flash, damage numbers
   - dash, combo/score multiplier, XP bar, minimap, kill feed
   - telegraphed boss attacks, enemy variety, parallax starfield bg
   ===================================================================== */

const bgcanvas = document.getElementById("bgcanvas");
const bgctx = bgcanvas.getContext("2d");
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
const fxcanvas = document.getElementById("fxcanvas");
const fxctx = fxcanvas.getContext("2d");
const mmcanvas = document.getElementById("minimap");
const mmctx = mmcanvas.getContext("2d");
const MM_SIZE = 120;

function resize(){
  for(const c of [bgcanvas, canvas, fxcanvas]){
    c.width = innerWidth;
    c.height = innerHeight;
  }
  mmcanvas.width = MM_SIZE; mmcanvas.height = MM_SIZE;
}
addEventListener("resize", resize);
resize();

// =========================================================
// AUDIO ENGINE — fully synthesized (Web Audio API), no external files
// =========================================================
const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
let actx = null, masterGain = null, musicGain = null, sfxGain = null;
let muted = false;
let musicPlaying = false, musicStepIndex = 0, musicNextTime = 0, musicSchedulerId = null;
let musicBossMode = false;
const MUSIC_STEP_DUR = 0.24;
const SCALE_STEPS = [0,2,3,5,7,8,10]; // A natural minor, semitone offsets from root

// Each track = a mood: a pool of 4-bar chord progressions (rotated every 4 bars for
// variety), a tempo multiplier, drum feel, and volume balance for lead/pad layers.
// scheduleMusic() re-evaluates which track is active every pass, so the score reacts
// live to menu <-> gameplay <-> boss-fight transitions with no hard restart/cut.
const MUSIC_TRACKS = {
  menu: {
    progressions: [ [0,3,0,4], [0,4,3,0] ], // calm i-iv-i-v style loops
    tempoMult: 1.35, drums:"sparse", padVol:0.05, leadVol:0.55, leadType:"sine",
  },
  classic: {
    progressions: [ [0,5,6,0], [0,6,3,4] ],
    tempoMult: 1, drums:"full", padVol:0.035, leadVol:1, leadType:"square",
  },
  bossrush: {
    progressions: [ [0,6,3,6], [0,1,6,0] ],
    tempoMult: 0.9, drums:"heavy", padVol:0.05, leadVol:1.15, leadType:"sawtooth",
  },
  swarm: {
    progressions: [ [0,2,5,6], [0,5,2,6] ],
    tempoMult: 0.86, drums:"fast", padVol:0.03, leadVol:1.1, leadType:"square",
  },
};
function currentMusicTrack(){
  if(!started) return MUSIC_TRACKS.menu;
  return MUSIC_TRACKS[gameMode] || MUSIC_TRACKS.classic;
}

function noteFreq(baseHz, semitoneOffset){ return baseHz * Math.pow(2, semitoneOffset/12); }
function chordTones(rootDegree){
  const deg = i => {
    const idx = rootDegree + i;
    return SCALE_STEPS[idx % 7] + Math.floor(idx/7)*12;
  };
  return [deg(0), deg(2), deg(4)]; // root, third, fifth
}
function playKick(t0, vol){
  if(!actx) return;
  const osc = actx.createOscillator(), g = actx.createGain();
  osc.type = "sine";
  osc.frequency.setValueAtTime(150, t0);
  osc.frequency.exponentialRampToValueAtTime(45, t0+0.12);
  g.gain.setValueAtTime(vol, t0);
  g.gain.exponentialRampToValueAtTime(0.001, t0+0.16);
  osc.connect(g); g.connect(musicGain);
  osc.start(t0); osc.stop(t0+0.18);
}
function playSnare(t0, vol){ playNoiseAt(0.12, vol, musicGain, 1800, t0, "highpass"); }
function playHat(t0, vol){ playNoiseAt(0.04, vol, musicGain, 7000, t0, "highpass"); }

function initAudio(){
  if(actx) return;
  try{
    actx = new AudioCtxClass();
    masterGain = actx.createGain(); masterGain.gain.value = muted ? 0 : volumeLevel; masterGain.connect(actx.destination);
    musicGain = actx.createGain(); musicGain.gain.value = 0.4; musicGain.connect(masterGain);
    sfxGain = actx.createGain(); sfxGain.gain.value = 0.85; sfxGain.connect(masterGain);
  } catch(e){ actx = null; }
}

function toggleMute(e){
  if(e) e.stopPropagation();
  initAudio();
  if(actx && actx.state === "suspended") actx.resume();
  muted = !muted;
  if(masterGain) masterGain.gain.setTargetAtTime(muted?0:volumeLevel, actx.currentTime, 0.05);
  const btn = document.getElementById("mutebtn");
  if(btn) btn.textContent = muted ? "🔇" : "🔊";
}

function playToneAt(freq, dur, type, gainNode, vol, t0){
  if(!actx || !gainNode) return;
  const osc = actx.createOscillator(), g = actx.createGain();
  osc.type = type; osc.frequency.setValueAtTime(freq, t0);
  g.gain.setValueAtTime(0, t0);
  g.gain.linearRampToValueAtTime(vol, t0+0.008);
  g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
  osc.connect(g); g.connect(gainNode);
  osc.start(t0); osc.stop(t0+dur+0.03);
}
function playTone(freq, dur, type="sine", gainNode=sfxGain, vol=0.25){
  if(!actx) return;
  playToneAt(freq, dur, type, gainNode, vol, actx.currentTime);
}
function playNoiseAt(dur, vol, gainNode, filterFreq, t0, filterType="lowpass"){
  if(!actx || !gainNode) return;
  const bufferSize = Math.max(1, Math.floor(actx.sampleRate*dur));
  const buffer = actx.createBuffer(1, bufferSize, actx.sampleRate);
  const data = buffer.getChannelData(0);
  for(let i=0;i<bufferSize;i++) data[i] = (Math.random()*2-1) * (1 - i/bufferSize);
  const noise = actx.createBufferSource(); noise.buffer = buffer;
  const f = actx.createBiquadFilter(); f.type = filterType; f.frequency.value = filterFreq;
  const g = actx.createGain();
  g.gain.setValueAtTime(vol, t0);
  g.gain.exponentialRampToValueAtTime(0.001, t0+dur);
  noise.connect(f); f.connect(g); g.connect(gainNode);
  noise.start(t0);
}
function playNoise(dur, vol, gainNode=sfxGain, filterFreq=1200, filterType="lowpass"){
  if(!actx) return;
  playNoiseAt(dur, vol, gainNode, filterFreq, actx.currentTime, filterType);
}

