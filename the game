      </label>
    </div>
    <div id="diffselect-label">Difficulty</div>
    <div id="diffselect">
      <button class="diffbtn" data-diff="easy" onclick="selectDifficulty('easy')">EASY</button>
      <button class="diffbtn active" data-diff="normal" onclick="selectDifficulty('normal')">NORMAL</button>
      <button class="diffbtn" data-diff="hard" onclick="selectDifficulty('hard')">HARD</button>
    </div>
    <div id="schemeselect-label">Control Scheme</div>
    <div id="schemeselect">
      <button class="schemebtn" data-scheme="keyboard" onclick="selectControlScheme('keyboard')">
        <span class="ico">⌨</span><b>KEYBOARD</b>
      </button>
      <button class="schemebtn" data-scheme="touch" onclick="selectControlScheme('touch')">
        <span class="ico">👆</span><b>TOUCH</b>
      </button>
      <button class="schemebtn" data-scheme="controller" onclick="selectControlScheme('controller')">
        <span class="ico">🎮</span><b>CONTROLLER</b>
      </button>
    </div>
    <button class="bigbtn" onclick="startGame()">START RUN</button>
    <div class="stats">Best Score <b id="beststat">0</b> &nbsp;|&nbsp; Best Wave <b id="bestwavestat">0</b></div>
    <button class="smallbtn" id="achbtn" style="margin-top:14px;" onclick="openAchievements()">🏆 ACHIEVEMENTS (<span id="achcount">0</span>/<span id="achtotal">0</span>)</button>
    <div id="recentruns"></div>
    <div id="controls-hint">
      <span>WASD</span> move &nbsp; <span>MOUSE</span> aim &nbsp; <span>CLICK / SPACE</span> fire &nbsp; <span>SHIFT</span> dash<br>
      <span>Q / SCROLL / RIGHT-CLICK</span> switch weapon &nbsp; <span>R</span> reload<br>
      Arrow keys / IJKL also work &nbsp;|&nbsp; Survive waves, pick weapons, chain kills for combo score
    </div>
    <div id="scheme-note" style="margin-top:10px;font-size:11px;color:var(--dim);letter-spacing:.5px;">All control types work here in the menu — pick your scheme just for in-game touch controls.</div>
  </div>
</div>

<!-- HUD -->
<div id="ui" class="hidden">
  <div class="panel">
    <div class="row"><span class="label">HP</span><div class="bar-bg"><div class="bar-fill" id="hpfill" style="width:100%"></div></div><span class="val" id="hpval">100</span></div>
    <div class="row"><span class="label">XP</span><div class="bar-bg"><div class="bar-fill" id="xpfill" style="width:0%"></div></div><span class="val" id="xpval">0</span></div>
    <div class="row weaponrow" id="rowA"><span class="label">Slot 1</span><span id="weaponnameA">Pistol</span></div>
    <div class="row ammorow"><div class="bar-bg" id="reloadbarA"><div class="bar-fill" id="reloadfillA" style="width:100%;background:#2ee6d6;"></div></div><span class="val" id="ammovalA">12/12</span></div>
    <div class="row weaponrow" id="rowB"><span class="label">Slot 2</span><span id="weaponnameB">— empty —</span></div>
    <div class="row ammorow"><div class="bar-bg" id="reloadbarB"><div class="bar-fill" id="reloadfillB" style="width:0%;background:#2ee6d6;"></div></div><span class="val" id="ammovalB">-/-</span></div>
    <div class="row"><span class="label">Power</span><span class="val" id="dmgval" style="text-align:left;">x1.0</span></div>
    <div id="jammsg"></div>
  </div>
  <div id="topcenter">
    <div id="wavebadge">WAVE <span id="waveval">1</span></div>
    <div id="wavemsg"></div>
  </div>
  <div class="panel" style="text-align:right;">
    <div id="scorebadge">SCORE<br><b id="scoreval">0</b></div>
    <div id="combo"></div>
  </div>
</div>

<canvas id="minimap" class="hidden"></canvas>
<div id="swarmarsenal" class="hidden"></div>
<div id="killfeed"></div>
<div id="lowhp"></div>
<div id="poisonvign"></div>
<button id="mutebtn" onclick="toggleMute(event)">🔊</button>
<button id="settingsbtn" onclick="toggleSettingsPanel(event)">⚙</button>
<button id="pausebtn" onclick="togglePause()">⏸</button>
<div id="settingspanel" class="hidden">
  <div class="opt-title">Options</div>
  <div class="opt-row opt-volume-row">
    <span>Volume</span>
    <input type="range" id="opt-volume" min="0" max="100" value="55" oninput="onVolumeChange(this.value)">
  </div>
  <label class="opt-row"><input type="checkbox" id="opt-shake" onchange="onSettingChange('screenShake', this.checked)"> Screen Shake</label>
  <label class="opt-row"><input type="checkbox" id="opt-flash" onchange="onSettingChange('screenFlash', this.checked)"> Screen Flash</label>
