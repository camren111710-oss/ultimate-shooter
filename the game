// touch controls
function setupStick(zoneId, stickId, state){
  const zone = document.getElementById(zoneId);
  const stick = document.getElementById(stickId);
  let originX=0, originY=0;
  const activeTouches = new Map();

  zone.addEventListener("touchstart", e=>{
    e.preventDefault();
    const t = e.changedTouches[0];
    const rect = zone.getBoundingClientRect();
    originX = rect.left + rect.width/2;
    originY = rect.top + rect.height/2;
    activeTouches.set(t.identifier, true);
    state.active = true;
  }, {passive:false});

  zone.addEventListener("touchmove", e=>{
    e.preventDefault();
    const t = e.changedTouches[0];
    let dx = t.clientX - originX;
    let dy = t.clientY - originY;
    const max = 40;
    const dist = Math.hypot(dx,dy);
    if(dist > max){ dx = dx/dist*max; dy = dy/dist*max; }
    stick.style.transform = `translate(${dx-27}px, ${dy-27}px)`;
    state.dx = dx/max; state.dy = dy/max;
    if(zoneId === "touch-aim" && dist > 8){
      mouse.x = player.x + dx*10;
      mouse.y = player.y + dy*10;
      fire();
    }
  }, {passive:false});

  function end(e){
    e.preventDefault();
    activeTouches.clear();
    state.active = false; state.dx = 0; state.dy = 0;
    stick.style.transform = `translate(-50%,-50%)`;
  }
  zone.addEventListener("touchend", end, {passive:false});
  zone.addEventListener("touchcancel", end, {passive:false});
}
setupStick("touch-move","stick-move", touchMove);
setupStick("touch-aim","stick-aim", touchAim);

