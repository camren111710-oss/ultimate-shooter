  .choice:hover::after{opacity:1;}
  .choice:hover{transform:translateY(-6px) scale(1.02);border-color:var(--accent2);box-shadow:0 8px 30px rgba(46,230,214,.25);}
  .choice:active{transform:translateY(-2px) scale(.99);}
  .choice.gp-focus{
    transform:translateY(-6px) scale(1.04);
