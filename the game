<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ULTIMATE SHOOTER // OVERDRIVE</title>
<style>
  :root{
    --bg:#05060a;
    --bg2:#0a0d16;
    --grid:#131826;
    --accent:#ff3860;
    --accent2:#2ee6d6;
    --accent3:#ffcf3d;
    --text:#e9edf5;
    --dim:#7b8397;
    --panel:rgba(10,13,22,0.86);
    --border:rgba(255,255,255,0.08);
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;padding:0;overflow:hidden;
    background:var(--bg);
    font-family:'Courier New',ui-monospace,monospace;
    color:var(--text);
    height:100%;width:100%;
    -webkit-user-select:none;user-select:none;
  }
  canvas{display:block;position:fixed;inset:0;touch-action:none;}
  #bgcanvas{z-index:0;}
  #game{z-index:1;}
  #fxcanvas{z-index:2;pointer-events:none;}

  .hidden{display:none !important;}

  /* ---------- MENU ---------- */
  #menu{
    position:fixed;inset:0;z-index:50;
    display:flex;align-items:center;justify-content:center;
    background:radial-gradient(ellipse at 50% 30%, rgba(18,24,42,.55) 0%, rgba(5,6,10,.9) 72%);
    animation:fadeIn .4s ease;
    overflow:hidden;
  }
  .menu-content{
    position:relative;z-index:5;
    display:flex;align-items:center;justify-content:center;flex-direction:column;gap:6px;
  }
  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  @keyframes menuRise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}

  /* corner HUD brackets */
  .hud-corner{position:absolute;width:44px;height:44px;border:2px solid var(--accent2);opacity:.5;z-index:2;pointer-events:none;
    animation:cornerPulse 3.2s ease-in-out infinite;}
  .hud-corner.tl{top:20px;left:20px;border-right:none;border-bottom:none;}
  .hud-corner.tr{top:20px;right:20px;border-left:none;border-bottom:none;}
  .hud-corner.bl{bottom:20px;left:20px;border-right:none;border-top:none;}
  .hud-corner.br{bottom:20px;right:20px;border-left:none;border-top:none;}
  @keyframes cornerPulse{0%,100%{opacity:.35;}50%{opacity:.75;}}

  /* slow-rotating radar rings behind the title */
  .menu-radar{
    position:absolute;top:50%;left:50%;width:900px;height:900px;
    transform:translate(-50%,-50%);z-index:1;pointer-events:none;
    border-radius:50%;
    background:
      repeating-radial-gradient(circle, rgba(46,230,214,.05) 0px, rgba(46,230,214,.05) 1px, transparent 1px, transparent 90px);
    -webkit-mask-image:radial-gradient(circle, #000 0%, transparent 72%);
    mask-image:radial-gradient(circle, #000 0%, transparent 72%);
    animation:radarSpin 60s linear infinite;
  }
  .menu-radar::before{
    content:"";position:absolute;inset:0;border-radius:50%;
    background:conic-gradient(from 0deg, rgba(46,230,214,.14), transparent 22%);
  }
  @keyframes radarSpin{from{transform:translate(-50%,-50%) rotate(0deg);}to{transform:translate(-50%,-50%) rotate(360deg);}}

  /* fine horizontal scanline texture across the whole menu */
  .menu-scanline{
    position:absolute;inset:0;z-index:2;pointer-events:none;
    background:repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0px, rgba(255,255,255,.035) 1px, transparent 1px, transparent 3px);
    mix-blend-mode:overlay;
  }

  /* single bright scan beam sweeping top to bottom */
  .menu-sweep{
    position:absolute;left:0;right:0;height:140px;z-index:2;pointer-events:none;top:-140px;
    background:linear-gradient(180deg, transparent, rgba(46,230,214,.09), transparent);
    animation:sweepDown 5.5s linear infinite;
  }
  @keyframes sweepDown{0%{top:-140px;}100%{top:100%;}}

  /* animated film-grain texture */
  .menu-grain{
    position:absolute;inset:-50%;width:200%;height:200%;z-index:2;pointer-events:none;opacity:.05;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    animation:grainShift .5s steps(4) infinite;
  }
  @keyframes grainShift{
    0%{transform:translate(0,0);}25%{transform:translate(-2%,1%);}
    50%{transform:translate(1%,-2%);}75%{transform:translate(-1%,2%);}100%{transform:translate(0,0);}
  }

  /* soft vignette to focus the eye on the center */
  .menu-vignette{
    position:absolute;inset:0;z-index:3;pointer-events:none;
    box-shadow:inset 0 0 220px 60px rgba(0,0,0,.75);
  }

  #menu h1{
    position:relative;
    font-size:clamp(38px,8vw,84px);
    margin:0;
    letter-spacing:6px;
    font-weight:900;
    background:linear-gradient(180deg,#fff 0%, var(--accent2) 60%, var(--accent) 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:0 0 40px rgba(46,230,214,0.25);
    animation:pulseGlow 3s ease-in-out infinite, menuRise .6s cubic-bezier(.2,.8,.3,1);
  }
  #menu h1::before, #menu h1::after{
    content:attr(data-text);position:absolute;left:0;top:0;width:100%;
    background:none;-webkit-text-fill-color:initial;color:var(--accent2);
    clip-path:inset(0 0 92% 0);opacity:0;
  }
  #menu h1::before{color:var(--accent);animation:glitchTop 6.5s ease-in-out infinite;}
  #menu h1::after{color:var(--accent2);animation:glitchBottom 6.5s ease-in-out infinite;}
  @keyframes glitchTop{
    0%,92%,100%{opacity:0;transform:translate(0,0);clip-path:inset(0 0 92% 0);}
    93%{opacity:.8;transform:translate(-3px,0);clip-path:inset(10% 0 75% 0);}
    95%{opacity:.8;transform:translate(3px,0);clip-path:inset(40% 0 35% 0);}
    97%{opacity:0;transform:translate(0,0);}
  }
  @keyframes glitchBottom{
    0%,90%,100%{opacity:0;transform:translate(0,0);clip-path:inset(60% 0 0 0);}
    91%{opacity:.8;transform:translate(3px,0);clip-path:inset(55% 0 20% 0);}
    94%{opacity:.8;transform:translate(-3px,0);clip-path:inset(20% 0 60% 0);}
    96%{opacity:0;transform:translate(0,0);}
  }
  @keyframes pulseGlow{
    0%,100%{filter:drop-shadow(0 0 8px rgba(255,56,96,.35));letter-spacing:6px;}
    50%{filter:drop-shadow(0 0 22px rgba(46,230,214,.55));letter-spacing:7px;}
  }
  #menu .sub{color:var(--dim);letter-spacing:4px;font-size:13px;margin-bottom:28px;text-transform:uppercase;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .08s backwards;}
  .bigbtn{
    padding:16px 52px;font-size:20px;letter-spacing:3px;font-weight:700;
    cursor:pointer;background:linear-gradient(180deg,#151b2c,#0a0d16);
    color:var(--text);border:2px solid var(--accent2);
    text-transform:uppercase;position:relative;overflow:hidden;
    transition:transform .12s ease, box-shadow .12s ease, letter-spacing .12s ease;
    font-family:inherit;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .16s backwards;
  }
  .bigbtn::before{
    content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.35),transparent);
    transform:skewX(-20deg);transition:left .5s ease;
  }
  .bigbtn:hover::before{left:130%;}
  .bigbtn:hover{transform:translateY(-2px) scale(1.03);box-shadow:0 0 26px rgba(46,230,214,.45);letter-spacing:4px;}
  .bigbtn:active{transform:translateY(1px) scale(.98);}
  #menu .stats{margin-top:26px;display:flex;gap:26px;color:var(--dim);font-size:13px;letter-spacing:1px;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .24s backwards;}
  #menu .stats b{color:var(--accent3);}
  #recentruns{
    margin-top:14px;display:flex;flex-direction:column;gap:3px;min-width:280px;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .28s backwards;
  }
  #recentruns .rr-title{color:var(--dim);font-size:10px;letter-spacing:2px;text-transform:uppercase;text-align:center;margin-bottom:4px;}
  #recentruns .rr-row{
    display:flex;justify-content:space-between;gap:10px;font-size:11.5px;letter-spacing:.5px;
    color:var(--dim);padding:3px 10px;
  }
  #recentruns .rr-row .rr-score{color:var(--text);font-weight:700;}
  #recentruns .rr-row .rr-diff-easy{color:#5ec93d;}
  #recentruns .rr-row .rr-diff-normal{color:var(--accent3);}
  #recentruns .rr-row .rr-diff-hard{color:var(--accent);}
  #controls-hint{margin-top:22px;font-size:12px;color:var(--dim);letter-spacing:1px;text-align:center;line-height:1.8;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .32s backwards;}
  #controls-hint span{color:var(--accent2);}

  #modeselect{
    display:flex;gap:12px;margin-bottom:22px;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .12s backwards;
  }
  .modebtn{
    padding:12px 16px;width:150px;
    background:linear-gradient(180deg,#12172400,#0a0d16);
    border:1.5px solid var(--border);color:var(--dim);
    cursor:pointer;font-family:inherit;text-align:left;
    border-radius:6px;transition:border-color .15s ease, transform .12s ease, background .15s ease;
  }
  .modebtn b{display:block;color:var(--text);font-size:13px;letter-spacing:2px;margin-bottom:5px;}
  .modebtn span{display:block;font-size:10.5px;line-height:1.4;color:var(--dim);letter-spacing:0.5px;}
  .modebtn:hover{transform:translateY(-2px);border-color:var(--accent2);}
  .modebtn.active{border-color:var(--accent3);background:linear-gradient(180deg,#1c1220,#0a0d16);}
  .modebtn.active b{color:var(--accent3);}

  /* difficulty toggle */
  #diffselect-label{color:var(--dim);font-size:10px;letter-spacing:2px;text-transform:uppercase;text-align:center;margin-bottom:8px;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .08s backwards;}
  #diffselect{
    display:flex;gap:10px;margin-bottom:18px;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .09s backwards;
  }
  .diffbtn{
    padding:8px 18px;width:96px;
    background:linear-gradient(180deg,#12172400,#0a0d16);
    border:1.5px solid var(--border);color:var(--dim);
    cursor:pointer;font-family:inherit;text-align:center;
    border-radius:6px;transition:border-color .15s ease, transform .12s ease, background .15s ease;
    font-size:11px;letter-spacing:1.5px;font-weight:700;
  }
  .diffbtn:hover{transform:translateY(-2px);border-color:var(--accent2);}
  .diffbtn.active[data-diff="easy"]{border-color:#5ec93d;background:linear-gradient(180deg,#122010,#0a0d16);color:#5ec93d;}
  .diffbtn.active[data-diff="normal"]{border-color:var(--accent3);background:linear-gradient(180deg,#1c1220,#0a0d16);color:var(--accent3);}
  .diffbtn.active[data-diff="hard"]{border-color:var(--accent);background:linear-gradient(180deg,#22111a,#0a0d16);color:var(--accent);}

  /* swarm solo-weapon toggle */
  #swarmsolo-row{margin-bottom:18px;animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .1s backwards;}
  #swarmsolo-row label{
    display:flex;align-items:center;gap:9px;cursor:pointer;justify-content:center;
    padding:9px 16px;border:1.5px solid var(--border);max-width:400px;margin:0 auto;
    transition:border-color .15s ease;
  }
  #swarmsolo-row label:hover{border-color:var(--accent);}
  #swarmsolo-row input{width:15px;height:15px;accent-color:var(--accent);cursor:pointer;flex-shrink:0;}
  #swarmsolo-row span{color:var(--dim);font-size:10.5px;letter-spacing:.5px;line-height:1.5;text-align:left;}

  /* ---------- SWARM SOLO WEAPON DRAFT ---------- */
  #solopick{
    position:fixed;inset:0;z-index:46;display:none;
    align-items:center;justify-content:center;flex-direction:column;gap:14px;
    background:rgba(3,4,8,0.96);backdrop-filter:blur(4px);
    padding:30px 20px;
  }
  #solopick h1{
    font-size:clamp(22px,3.6vw,34px);letter-spacing:5px;margin:0;
    color:var(--text);text-transform:uppercase;text-shadow:0 0 20px rgba(255,56,96,.4);
    animation:menuRise .5s cubic-bezier(.2,.8,.3,1);text-align:center;
  }
  #solopick .solopick-sub{color:var(--dim);font-size:12px;letter-spacing:1.5px;text-align:center;max-width:600px;line-height:1.6;}
  #solopick-controls{display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;max-width:900px;}
  #solopick-search{
    width:320px;max-width:90vw;padding:10px 14px;font-family:inherit;font-size:13px;letter-spacing:1px;
    background:#0d0f18;border:1.5px solid var(--border);color:var(--text);text-transform:uppercase;
  }
  #solopick-search:focus{outline:none;border-color:var(--accent2);}
  #solopick-rarities{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;}
  .solo-rarity-btn{
    padding:6px 14px;font-size:10px;letter-spacing:1.5px;font-weight:700;
    background:transparent;border:1.5px solid var(--border);color:var(--dim);
    cursor:pointer;font-family:inherit;text-transform:uppercase;
    transition:border-color .12s ease,color .12s ease;
  }
  .solo-rarity-btn:hover{border-color:var(--accent2);}
  .solo-rarity-btn.active{border-color:var(--accent3);color:var(--accent3);}
  #solopick-count{color:var(--dim);font-size:10px;letter-spacing:1px;}
  #solopick-grid{
    display:flex;gap:14px;flex-wrap:wrap;justify-content:center;align-content:flex-start;
    max-width:1020px;max-height:44vh;overflow-y:auto;padding:10px 6px;width:100%;
  }
  .solopick-card{width:180px;padding:16px 14px;}
  .solopick-card .wname{font-size:14px;margin:16px 0 8px;}
  .solopick-card .wstats{font-size:10.5px;}

  /* control scheme toggle */
  #schemeselect{
    display:flex;gap:10px;margin-bottom:18px;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .1s backwards;
  }
  .schemebtn{
    padding:9px 14px;width:110px;
    background:linear-gradient(180deg,#12172400,#0a0d16);
    border:1.5px solid var(--border);color:var(--dim);
    cursor:pointer;font-family:inherit;text-align:center;
    border-radius:6px;transition:border-color .15s ease, transform .12s ease, background .15s ease;
    font-size:10.5px;letter-spacing:1px;
  }
  .schemebtn .ico{display:block;font-size:17px;margin-bottom:4px;}
  .schemebtn b{display:block;color:var(--text);font-size:10.5px;letter-spacing:1.5px;font-weight:700;}
  .schemebtn:hover{transform:translateY(-2px);border-color:var(--accent2);}
  .schemebtn.active{border-color:var(--accent2);background:linear-gradient(180deg,#0f2422,#0a0d16);}
  .schemebtn.active b{color:var(--accent2);}
  #schemeselect-label{color:var(--dim);font-size:10px;letter-spacing:2px;text-transform:uppercase;text-align:center;margin-bottom:8px;
    animation:menuRise .6s cubic-bezier(.2,.8,.3,1) .06s backwards;}

  /* ---------- HUD ---------- */
  #ui{
    position:fixed;top:0;left:0;right:0;z-index:10;
    display:flex;justify-content:space-between;align-items:flex-start;
    padding:14px 18px;pointer-events:none;
  }
  .panel{
    background:var(--panel);
    border:1px solid var(--border);
    padding:10px 16px;
    backdrop-filter:blur(6px);
    min-width:230px;
  }
  .row{display:flex;align-items:center;gap:10px;margin:5px 0;font-size:13px;letter-spacing:1px;}
  .row .label{color:var(--dim);width:70px;flex-shrink:0;text-transform:uppercase;font-size:11px;}
  .bar-bg{flex:1;height:14px;background:#0d0f18;border:1px solid var(--border);position:relative;overflow:hidden;}
  .bar-bg::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.16) 50%,transparent 70%);
    background-size:200% 100%;animation:barSheen 2.6s linear infinite;
  }
  @keyframes barSheen{from{background-position:200% 0}to{background-position:-40% 0}}
  .bar-fill{height:100%;transition:width .15s ease;position:relative;}
  #hpfill{background:linear-gradient(90deg,#ff3860,#ff8a3d);box-shadow:0 0 10px rgba(255,56,96,.6);}
  #hpfill.low{animation:hpPulse .6s ease-in-out infinite;}
  @keyframes hpPulse{0%,100%{filter:brightness(1)}50%{filter:brightness(1.6)}}
  #xpfill{background:linear-gradient(90deg,#2ee6d6,#3dd6ff);box-shadow:0 0 8px rgba(46,230,214,.6);}
  .val{font-size:12px;color:var(--text);min-width:44px;text-align:right;}
  #weaponname{color:var(--accent3);font-weight:700;text-transform:uppercase;letter-spacing:2px;}
  .weaponrow{padding:3px 6px;margin:2px -6px;transition:background .15s ease, opacity .15s ease;opacity:0.55;}
  .weaponrow.active-slot{background:rgba(46,230,214,0.1);border-left:2px solid var(--accent2);opacity:1;}
  .weaponrow.jammed-slot{border-left:2px solid var(--accent);}
  .ammorow{gap:8px;margin-top:-2px;}
  .ammorow .bar-bg{height:7px;}
  #jammsg{color:var(--accent);font-size:12px;letter-spacing:2px;font-weight:700;height:14px;margin-top:2px;text-align:center;}
  #wavebadge{
    font-size:26px;font-weight:900;color:var(--text);letter-spacing:2px;
    text-shadow:0 0 12px rgba(255,255,255,.25);
    transition:transform .18s cubic-bezier(.3,1.6,.5,1);
  }
  #wavebadge.pop{transform:scale(1.35);}
  #wavebadge span{color:var(--accent);}
  #scorebadge{font-size:14px;color:var(--dim);letter-spacing:1px;}
  #scorebadge b{color:var(--text);font-size:16px;}
  #combo{
    font-size:13px;color:var(--accent3);letter-spacing:1px;height:16px;
  }

  #topcenter{position:absolute;top:14px;left:50%;transform:translateX(-50%);text-align:center;pointer-events:none;}
  #wavemsg{
    font-size:15px;color:var(--accent2);letter-spacing:3px;text-transform:uppercase;
    opacity:0;transition:opacity .3s ease;text-shadow:0 0 14px rgba(46,230,214,.6);
  }
  #wavemsg.show{opacity:1;}

  #minimap{
    position:fixed;top:300px;right:16px;width:120px;height:120px;
    background:var(--panel);border:1px solid var(--border);z-index:10;
  }

  #swarmarsenal{
    position:fixed;bottom:14px;left:50%;transform:translateX(-50%);z-index:11;
    display:flex;gap:6px;max-width:min(90vw,640px);flex-wrap:wrap;justify-content:center;
    pointer-events:auto;
  }
  .arsenal-pill{
    background:var(--panel);border:1.5px solid var(--border);color:var(--dim);
    font-size:10px;letter-spacing:.5px;padding:5px 10px;cursor:pointer;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:120px;
    transition:transform .1s ease, border-color .1s ease, color .1s ease;
  }
  .arsenal-pill:hover{transform:translateY(-2px);}
  .arsenal-pill.equipped{color:var(--text);font-weight:700;box-shadow:0 0 10px currentColor;}

  #killfeed{
    position:fixed;bottom:16px;left:16px;z-index:10;
    display:flex;flex-direction:column-reverse;gap:3px;pointer-events:none;
    font-size:11px;color:var(--dim);letter-spacing:1px;max-width:260px;
  }
  #killfeed div{opacity:0;animation:kfIn .3s cubic-bezier(.2,1.4,.4,1) forwards, kfOut .4s ease 2.2s forwards;}
  @keyframes kfIn{from{opacity:0;transform:translateX(-16px) scale(.9)}to{opacity:1;transform:translateX(0) scale(1)}}
  @keyframes kfOut{to{opacity:0;transform:translateX(-6px);}}

  #lowhp{
    position:fixed;inset:0;z-index:12;pointer-events:none;opacity:0;
    background:radial-gradient(ellipse at 50% 50%, rgba(255,20,40,0) 55%, rgba(255,20,40,.45) 100%);
    transition:opacity .3s ease;
  }
  #lowhp.show{opacity:1;animation:lowhpPulse 1.1s ease-in-out infinite;}
  @keyframes lowhpPulse{0%,100%{opacity:.55}50%{opacity:.95}}

  /* ---------- UPGRADE ---------- */
  #upgrade{
    position:fixed;inset:0;z-index:40;display:none;
    align-items:center;justify-content:center;flex-direction:column;gap:22px;
    background:rgba(3,4,8,0.94);
    backdrop-filter:blur(4px);
  }
  #upgrade h1{
    font-size:clamp(24px,4vw,40px);letter-spacing:6px;margin:0;
    color:var(--text);text-transform:uppercase;
    text-shadow:0 0 20px rgba(255,56,96,.4);
    animation:menuRise .5s cubic-bezier(.2,.8,.3,1);
  }
  #upgrade .waveclear{color:var(--accent2);font-size:14px;letter-spacing:3px;margin-bottom:-6px;
    animation:menuRise .5s cubic-bezier(.2,.8,.3,1);}
  #choices{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;max-width:1000px;}
  .choice{
    width:230px;padding:22px 18px;border:2px solid var(--border);
    background:linear-gradient(180deg,#12172a,#0a0d16);
    cursor:pointer;text-align:center;position:relative;overflow:hidden;
    transition:transform .15s cubic-bezier(.3,1.4,.4,1), border-color .15s ease, box-shadow .15s ease;
    opacity:0;animation:cardIn .45s cubic-bezier(.2,.9,.3,1.1) forwards;
  }
  .choice:nth-child(1){animation-delay:.05s;}
  .choice:nth-child(2){animation-delay:.14s;}
  .choice:nth-child(3){animation-delay:.23s;}
  @keyframes cardIn{
    from{opacity:0;transform:translateY(26px) scale(.92);}
    to{opacity:1;transform:translateY(0) scale(1);}
  }
  .choice::after{
    content:"";position:absolute;inset:0;
