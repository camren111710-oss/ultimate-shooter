  }
  .choice.gp-focus::after{opacity:1;background:radial-gradient(circle at 50% 0%, rgba(255,207,61,.22), transparent 60%);}
  .choice .rk{
    position:absolute;top:8px;left:10px;font-size:10px;letter-spacing:2px;font-weight:700;
  }
  .choice .num{position:absolute;top:8px;right:12px;color:var(--dim);font-size:12px;}
  .choice .wname{font-size:18px;font-weight:900;text-transform:uppercase;letter-spacing:1px;margin:22px 0 10px;}
  .choice .wtype{font-size:11px;color:var(--dim);letter-spacing:2px;margin-bottom:14px;text-transform:uppercase;}
  .choice .wstats{font-size:12px;color:var(--text);line-height:1.9;text-align:left;padding:0 4px;}
  .choice .wstats b{color:var(--accent3);float:right;}
  .rk.common{color:#9aa3b5;}
  .rk.rare{color:#2ee6d6;}
  .rk.epic{color:#c06bff;}
  .rk.legendary{color:#ffcf3d;}
  .rk.mythic{color:#ff3860;}
  .rk.secret{color:#fff;text-shadow:0 0 6px #fff,0 0 14px #ff2bd6,0 0 22px #5adfff;animation:secretShimmer 1.4s linear infinite;}
  @keyframes secretShimmer{0%{filter:hue-rotate(0deg) brightness(1);}50%{filter:hue-rotate(180deg) brightness(1.4);}100%{filter:hue-rotate(360deg) brightness(1);}}
  .choice.secret-card{border-color:#fff;box-shadow:0 0 10px rgba(255,255,255,.4), 0 0 40px rgba(255,43,214,.35);animation:secretCardPulse 1.6s ease-in-out infinite;}
  @keyframes secretCardPulse{0%,100%{box-shadow:0 0 10px rgba(255,255,255,.4), 0 0 30px rgba(255,43,214,.3);}50%{box-shadow:0 0 20px rgba(255,255,255,.7), 0 0 55px rgba(90,223,255,.45);}}
  #upgrade .hint{color:var(--dim);font-size:12px;letter-spacing:2px;}
  #upgrade .hint span{color:var(--accent2);}

  #mutebtn{
    position:fixed;top:92px;right:14px;z-index:20;
    width:34px;height:34px;border-radius:50%;
    background:var(--panel);border:1px solid var(--border);
    color:var(--text);font-size:15px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    pointer-events:auto;
  }
  #settingsbtn{
    position:fixed;top:92px;right:56px;z-index:20;
    width:34px;height:34px;border-radius:50%;
    background:var(--panel);border:1px solid var(--border);
    color:var(--text);font-size:15px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    pointer-events:auto;
  }
  #pausebtn{
    position:fixed;top:92px;right:98px;z-index:20;
    width:34px;height:34px;border-radius:50%;
    background:var(--panel);border:1px solid var(--border);
    color:var(--text);font-size:14px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    pointer-events:auto;
  }
  #settingspanel{
    position:fixed;top:134px;right:14px;z-index:58;
