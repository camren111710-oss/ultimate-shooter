function edgeSpawnPos(){
  const side = Math.floor(Math.random()*4);
  const pad = 60;
  if(side===0) return { x: Math.random()*canvas.width, y: -pad };
  if(side===1) return { x: Math.random()*canvas.width, y: canvas.height+pad };
  if(side===2) return { x: -pad, y: Math.random()*canvas.height };
  return { x: canvas.width+pad, y: Math.random()*canvas.height };
}

const ENEMY_COLOR = {
  normal:"#ff3860", runner:"#ffe066", tank:"#ff8a3d", shooter:"#ff5adf",
  bomber:"#ff5a1f", splitter:"#ffcf3d", shielded:"#5adfff", splitling:"#ffb84d",
  turret:"#b8bec9", vampire:"#a3193d",
};

function enemyTypeForWave(){
  const r = Math.random();
  if(wave >= 12 && r < 0.05) return "vampire";
  if(wave >= 9 && r < 0.11) return "turret";
  if(wave >= 10 && r < 0.17) return "shielded";
  if(wave >= 8 && r < 0.25) return "bomber";
  if(wave >= 7 && r < 0.33) return "splitter";
  if(wave >= 4 && r < 0.45) return "tank";
  if(wave >= 3 && r < 0.60) return "runner";
  if(wave >= 6 && r < 0.72) return "shooter";
  return "normal";
}

function spawnEnemy(forceType){
  const type = forceType || enemyTypeForWave();
  const pos = edgeSpawnPos();
  let e = {
    x: pos.x, y: pos.y,
    type,
    size: 12,
    hp: 34 + wave*5,
    speed: 1.1 + wave*0.055,
    poison: 0,
    hitFlash: 0,
    shootCd: 0,
    spawnT: 16, spawnMax: 16,
    squash: 0,
    wobble: Math.random()*Math.PI*2,
    shield: 0,
  };
  if(type === "tank"){ e.size=20; e.hp = (34+wave*5)*3.4; e.speed *= 0.55; }
  if(type === "runner"){ e.size=9; e.hp = (34+wave*5)*0.55; e.speed *= 1.9; }
  if(type === "shooter"){ e.size=11; e.hp = (34+wave*5)*0.8; e.speed *= 0.8; e.shootCd = 60+Math.random()*60; }
  if(type === "bomber"){ e.size=13; e.hp = (34+wave*5)*0.7; e.speed *= 1.45; }
  if(type === "splitter"){ e.size=16; e.hp = (34+wave*5)*1.3; e.speed *= 0.85; }
  if(type === "shielded"){ e.size=14; e.hp = (34+wave*5)*0.9; e.shield = (34+wave*5)*1.4; e.maxShield = e.shield; e.speed *= 0.75; }
  if(type === "turret"){ e.size=15; e.hp = (34+wave*5)*1.6; e.speed = 0; e.shootCd = 50+Math.random()*40; }
  if(type === "vampire"){ e.size=13; e.hp = (34+wave*5)*1.1; e.speed *= 1.1; }
  e.hp *= DIFF.hpMult; e.speed *= DIFF.speedMult;
  if(e.shield){ e.shield *= DIFF.hpMult; e.maxShield = e.shield; }
  e.maxHp = e.hp;
  enemies.push(e);
  spawnRings.push({ x:pos.x, y:pos.y, life:18, maxLife:18, color: ENEMY_COLOR[type] || "#ff3860" });
}

const BOSS_KINDS = [
  { key:"sentinel",   name:"THE SENTINEL",   color:"#c06bff", size:30, hpMult:220, speed:1.15 },
  { key:"juggernaut", name:"THE JUGGERNAUT", color:"#ff8a3d", size:38, hpMult:280, speed:0.85 },
  { key:"sniper_lord", name:"THE SNIPER LORD", color:"#5adfff", size:26, hpMult:190, speed:1.0 },
  { key:"swarm_queen", name:"THE SWARM QUEEN", color:"#5ec93d", size:28, hpMult:200, speed:1.1 },
  { key:"plague_mother", name:"THE PLAGUE MOTHER", color:"#8a8f2b", size:32, hpMult:235, speed:0.95 },
  { key:"reaper_king", name:"THE REAPER KING", color:"#ff2bd6", size:34, hpMult:265, speed:1.05 },
];

function spawnBoss(sequential){
  const idx = sequential ? (wave-1) % BOSS_KINDS.length : Math.floor(wave/5 - 1) % BOSS_KINDS.length;
  const kind = BOSS_KINDS[idx];
  const pos = { x: canvas.width/2, y: -100 };
  const scale = sequential ? (1 + (wave-1)*0.35) : wave; // boss rush scales per-boss instead of per-wave
  enemies.push({
    x: pos.x, y: pos.y, type:"boss", bossKind: kind.key, bossColor: kind.color,
    size: kind.size,
    hp: kind.hpMult*scale*DIFF.hpMult, maxHp: kind.hpMult*scale*DIFF.hpMult,
    speed: kind.speed*DIFF.speedMult, poison:0, hitFlash:0,
    attackCd: 90, telegraphT: 0,
    dashT: 0, dashAngle: 0,
    minionCd: 150,
    spawnT: 40, spawnMax: 40,
    squash: 0, wobble: 0, shield: 0,
  });
  spawnRings.push({ x:pos.x, y:pos.y, life:40, maxLife:40, color: kind.color, big:true });
  flashWaveMsg("!! " + kind.name + " INCOMING !!");
  playSfx("bossSpawn");
  shakeAmt = Math.max(shakeAmt, 14);
  musicBossMode = true;
}

function spawnWave(){
  waveCleared = false;
  killsThisWave = 0;

  if(gameMode === "bossrush"){
    setTimeout(()=>{ if(started) spawnBoss(true); }, 500);
    return;
  }

  if(gameMode === "swarm"){
    swarmSpawnCd = 20;
    for(let i=0;i<6;i++){
      setTimeout(()=>{ if(started) spawnEnemy(); }, i*160);
    }
    if(wave % 3 === 0){
      setTimeout(()=>{ if(started) spawnBoss(); }, 1200);
    }
    return;
  }

  const amount = 5 + wave*2;
  enemiesToSpawn = amount + (wave%5===0 ? 1 : 0);
  for(let i=0;i<amount;i++){
    setTimeout(()=>{ if(started) spawnEnemy(); }, i*140);
  }
  if(wave % 5 === 0){
    setTimeout(()=>{ if(started) spawnBoss(); }, amount*140 + 500);
  }
}

