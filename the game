function playSfx(name){ if(!actx || muted) return; try{ if(SFX[name]) SFX[name](); }catch(e){} }

// small chained-delay melody hits for multi-note stingers (levelup, waveclear, bossKill etc.)
function playChord(freqs, dur, type, vol, gap=0.08){
  if(!actx) return;
  freqs.forEach((f,i)=> playToneAt(f, dur, type, sfxGain, vol, actx.currentTime + i*gap));
}

function scheduleMusic(){
  if(!actx || !musicPlaying) return;
  while(musicNextTime < actx.currentTime + 0.6){
    const track = currentMusicTrack();
    const progSet = track.progressions;
    // rotate which progression in the pool is active every 4 bars (64 steps)
    const progIdx = Math.floor(musicStepIndex/64) % progSet.length;
    const progression = progSet[progIdx];

    const step = musicStepIndex % 16;
    const bar = Math.floor(musicStepIndex/16) % progression.length;
    const rootDeg = progression[bar];
    const tones = chordTones(rootDeg);
    const intensity = Math.min(1, wave/20);
    const boss = musicBossMode;

    // sustained pad chord — one soft, long swell per bar, gives the score body
    if(step === 0){
      for(const tone of tones){
        playToneAt(noteFreq(110, tone), MUSIC_STEP_DUR*15.5, "sine", musicGain,
          track.padVol + intensity*0.015, musicNextTime);
      }
    }

    // bass — root note of the current chord, low octave
    if(step % 2 === 0){
      playToneAt(noteFreq(110, tones[0]-12), MUSIC_STEP_DUR*0.85, boss?"sawtooth":"triangle", musicGain, boss?0.19:0.15, musicNextTime);
    }
    // arpeggiated lead over the chord tones
    if(step % (boss?1:2) === 0){
      const arpIdx = step % tones.length;
      playToneAt(noteFreq(110, tones[arpIdx]+12), MUSIC_STEP_DUR*0.45, track.leadType, musicGain,
        (0.045+intensity*0.05+(boss?0.05:0)) * track.leadVol, musicNextTime+MUSIC_STEP_DUR*0.08);
    }

    // drums — feel depends on the active track
    const drums = track.drums;
    if(drums === "sparse"){
      if(step % 16 === 0) playKick(musicNextTime, 0.16);
      if(step % 8 === 4) playHat(musicNextTime, 0.03);
    } else if(drums === "heavy"){
      if(step % 4 === 0) playKick(musicNextTime, 0.3+intensity*0.08);
      if(step % 8 === 4 || step % 8 === 6) playSnare(musicNextTime, 0.18);
      playHat(musicNextTime, 0.05+intensity*0.03);
    } else if(drums === "fast"){
      if(step % 8 === 0 || step % 8 === 4) playKick(musicNextTime, 0.26+intensity*0.08);
      if(step % 16 === 12) playSnare(musicNextTime, 0.16);
      playHat(musicNextTime, 0.04+intensity*0.03);
    } else { // "full" — classic
      if(step % 8 === 0) playKick(musicNextTime, 0.3+intensity*0.08);
      if(boss && step % 4 === 2) playKick(musicNextTime, 0.2);
      if(step % 8 === 4) playSnare(musicNextTime, 0.16+(boss?0.09:0));
      if(boss ? true : step % 2 === 0) playHat(musicNextTime, 0.045+intensity*0.03+(boss?0.03:0));
    }

    musicNextTime += MUSIC_STEP_DUR * track.tempoMult * (boss ? 0.82 : 1); // tempo picks up during boss fights
    musicStepIndex++;
  }
  musicSchedulerId = setTimeout(scheduleMusic, 150);
}
function startMusic(){
  initAudio();
  if(!actx) return;
  if(actx.state === "suspended") actx.resume();
  if(musicPlaying) return;
  musicPlaying = true;
  musicStepIndex = 0;
  musicNextTime = actx.currentTime + 0.1;
  scheduleMusic();
}
function stopMusic(){
  musicPlaying = false;
  if(musicSchedulerId){ clearTimeout(musicSchedulerId); musicSchedulerId = null; }
}

// menu music can't autoplay before a user gesture (browser policy) — kick it off on
// the first click/tap/keypress if the player hasn't started a run yet by then.
function primeMenuMusic(){
  if(started || musicPlaying) return;
  initAudio();
  if(actx && actx.state === "suspended") actx.resume();
  startMusic();
}
document.addEventListener("pointerdown", primeMenuMusic, { once:true });
document.addEventListener("keydown", primeMenuMusic, { once:true });

