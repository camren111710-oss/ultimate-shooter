// =========================================================
function spawnParticles(x,y,color,n=8){
  if(settings.reduceEffects) n = Math.max(1, Math.ceil(n*0.4));
  for(let i=0;i<n;i++){
    particles.push({
      x, y,
      dx: (Math.random()-0.5)*7,
      dy: (Math.random()-0.5)*7,
      life: 22+Math.random()*10, maxLife: 32,
      color, size: 2+Math.random()*2
    });
  }
}

function pushDamageText(x,y,val,crit){
  damageTexts.push({ x, y: y-10, val, life: 40, crit: !!crit, drift: (Math.random()-0.5)*0.6 });
}

// centralized damage application — handles shields (shielded enemy) and instakill weapons
function damageEnemy(e, dmg, opts={}){
  runStats.hitsLanded++;
  if(opts.instakill){
    if(e.type === "boss"){
      // even the rarest weapons can't one-shot a boss — but they hit HARD
      const bossDmg = e.maxHp * 0.12;
      e.hp -= bossDmg;
      runStats.damageDealt += bossDmg;
      e.hitFlash = 10; e.squash = 1.2;
      pushDamageText(e.x, e.y, Math.round(bossDmg), true);
      spawnParticles(e.x, e.y, "#ffffff", 16);
      playSfx("instakill");
      hitStopT = Math.max(hitStopT, 4);
      return;
    }
    e.shield = 0;
    runStats.damageDealt += e.hp;
    e.hp = -999999;
    e.hitFlash = 10; e.squash = 1.6;
    pushDamageText(e.x, e.y, "INSTAKILL", true);
    spawnParticles(e.x, e.y, "#ffffff", 24);
    spawnParticles(e.x, e.y, "#ff2bd6", 14);
    shockwaves.push({ x:e.x, y:e.y, radius:e.size*5, life:18, maxLife:18, color:"#ffffff" });
    playSfx("instakill");
    hitStopT = Math.max(hitStopT, 5);
    return;
  }
  if(e.shield > 0){
    const absorbed = Math.min(e.shield, dmg);
    e.shield -= absorbed;
    dmg -= absorbed;
    e.hitFlash = 4;
    spawnParticles(e.x, e.y, "#5adfff", 5);
    if(dmg <= 0) return;
  }
  e.hp -= dmg;
  runStats.damageDealt += dmg;
  e.hitFlash = 6;
  e.squash = 1;
  pushDamageText(e.x, e.y, Math.round(dmg));
  if(opts.poison) e.poison = 90;
  if(opts.burn) e.burn = 55;
  if(opts.color) spawnParticles(e.x, e.y, opts.color, opts.n || 5);
}

function explode(x,y,radius,damage,color,opts={}){
  explosionsFx.push({ x, y, radius, life:22, maxLife:22, color });
  shockwaves.push({ x, y, radius:radius*1.4, life:24, maxLife:24, color });
  spawnParticles(x, y, color, 10);
  spawnParticles(x, y, "#ffffff", 4);
  shakeAmt = Math.min(shakeAmt + radius/12, 20);
  playSfx("explosion");
  for(const e of enemies){
    const dist = Math.hypot(e.x-x, e.y-y);
    if(dist < radius){
      const falloff = 1 - dist/radius;
      const dmg = damage * falloff;
      damageEnemy(e, dmg, { instakill: opts.instakill, color });
    }
  }
  if(opts.hitsPlayer && started){
    const distPl = Math.hypot(player.x-x, player.y-y);
    if(distPl < radius && invulnT <= 0){
      const falloff = 1 - distPl/radius;
      hp -= playerTakeDamage(damage*0.5*falloff);
      flashAlpha = Math.min(flashAlpha+0.3, 0.6);
      shakeAmt = Math.min(shakeAmt+6, 20);
      if(hp<=0 && !gameOverShown){ hp=0; endGame(); }
    }
  }
}

