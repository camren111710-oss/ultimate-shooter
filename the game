  }
  #achmodal.show{display:flex;}
  #achmodal-inner{
    background:var(--panel);border:1.5px solid var(--border);
    padding:24px 28px;min-width:320px;max-width:420px;max-height:70vh;overflow-y:auto;
  }
  #achmodal-title{font-size:16px;letter-spacing:4px;color:var(--text);margin-bottom:14px;text-align:center;}
  .ach-row{
    display:flex;align-items:center;gap:12px;padding:9px 4px;
    border-bottom:1px solid rgba(255,255,255,0.06);
  }
  .ach-row .ach-ico{font-size:18px;width:26px;text-align:center;flex-shrink:0;}
  .ach-row .ach-name{font-size:13px;font-weight:700;letter-spacing:.5px;}
  .ach-row .ach-desc{font-size:11px;color:var(--dim);letter-spacing:.3px;}
  .ach-row.locked .ach-name{color:var(--dim);}
  .ach-row.locked .ach-ico{opacity:.35;}
  .ach-row.unlocked .ach-name{color:var(--accent2);}

  #achtoasts{
    position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:70;
    display:flex;flex-direction:column;gap:8px;pointer-events:none;align-items:center;
  }
  .ach-toast{
    background:var(--panel);border:1.5px solid var(--accent2);padding:10px 20px;
    display:flex;align-items:center;gap:10px;min-width:220px;
    animation:achToastIn .35s cubic-bezier(.2,.8,.3,1) forwards;
    box-shadow:0 0 24px rgba(46,230,214,.25);
  }
  .ach-toast.out{animation:achToastOut .4s ease forwards;}
  .ach-toast .ach-toast-ico{font-size:20px;}
  .ach-toast .ach-toast-label{font-size:9.5px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;}
  .ach-toast .ach-toast-name{font-size:13px;font-weight:700;color:var(--text);}
  @keyframes achToastIn{from{opacity:0;transform:translateY(-16px);}to{opacity:1;transform:translateY(0);}}
  @keyframes achToastOut{from{opacity:1;}to{opacity:0;transform:translateY(-10px);}}

  /* mobile touch controls */
  #touch-move, #touch-aim{
    position:fixed;bottom:26px;width:130px;height:130px;border-radius:50%;
    background:rgba(255,255,255,0.05);border:1px solid var(--border);
    z-index:15;display:none;touch-action:none;
  }
  #touch-move{left:26px;}
  #touch-aim{right:26px;background:rgba(255,56,96,0.06);border-color:rgba(255,56,96,0.25);}
  .stick{
    position:absolute;width:54px;height:54px;border-radius:50%;
    background:rgba(255,255,255,0.14);border:1px solid rgba(255,255,255,0.3);
    top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;
  }

  @media (max-width:820px){
    body:not([data-scheme="keyboard"]):not([data-scheme="controller"]) #touch-move,
    body:not([data-scheme="keyboard"]):not([data-scheme="controller"]) #touch-aim{display:block;}
    .panel{min-width:170px;padding:8px 12px;}
    #wavebadge{font-size:19px;}
  }
  /* control scheme forcing — overrides the media-query default above */
  body[data-scheme="touch"] #touch-move, body[data-scheme="touch"] #touch-aim{display:block !important;}
  body[data-scheme="keyboard"] #touch-move, body[data-scheme="keyboard"] #touch-aim{display:none !important;}
  body[data-scheme="controller"] #touch-move, body[data-scheme="controller"] #touch-aim{display:none !important;}
</style>
</head>
<body>

<canvas id="bgcanvas"></canvas>
<canvas id="game"></canvas>
<canvas id="fxcanvas"></canvas>

<!-- MENU -->
<div id="menu">
  <div class="hud-corner tl"></div>
  <div class="hud-corner tr"></div>
  <div class="hud-corner bl"></div>
  <div class="hud-corner br"></div>
  <div class="menu-radar"></div>
  <div class="menu-scanline"></div>
  <div class="menu-sweep"></div>
  <div class="menu-grain"></div>
  <div class="menu-vignette"></div>

  <div class="menu-content">
    <h1 data-text="ULTIMATE SHOOTER">ULTIMATE SHOOTER</h1>
    <div class="sub">// OVERDRIVE EDITION //</div>
    <div id="modeselect">
      <button class="modebtn active" data-mode="classic" onclick="selectMode('classic')">
        <b>CLASSIC</b><span>Waves build up. Boss every 5th wave.</span>
      </button>
      <button class="modebtn" data-mode="bossrush" onclick="selectMode('bossrush')">
        <b>BOSS RUSH</b><span>Every wave is a boss. No filler.</span>
      </button>
      <button class="modebtn" data-mode="swarm" onclick="selectMode('swarm')">
        <b>SWARM</b><span>Endless non-stop spawns. Survive.</span>
      </button>
    </div>
    <div id="swarmsolo-row" class="hidden">
      <label>
        <input type="checkbox" id="opt-swarmsolo" onchange="toggleSwarmSolo(this.checked)">
