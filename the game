// SWARM: SOLO WEAPON DRAFT — pick any non-secret weapon in the
// game at run start; it's the only one you get for the whole run.
// =========================================================
const RARITY_ORDER = { common:0, rare:1, epic:2, legendary:3, mythic:4 };
let soloPickableList = null;
function getSoloPickableList(){
  if(soloPickableList) return soloPickableList;
  soloPickableList = weaponKeys
    .filter(k => weapons[k].rarity !== "secret")
    .sort((a,b) => {
      const wa = weapons[a], wb = weapons[b];
      const ra = RARITY_ORDER[wa.rarity] ?? 0, rb = RARITY_ORDER[wb.rarity] ?? 0;
      if(ra !== rb) return ra - rb;
      return wa.displayName.localeCompare(wb.displayName);
    });
  return soloPickableList;
}

let soloFilterRarity = "all";
function showSoloWeaponPick(){
  soloPicking = true;
  soloFilterRarity = "all";
  const search = document.getElementById("solopick-search");
  if(search) search.value = "";
  document.querySelectorAll(".solo-rarity-btn").forEach(b => b.classList.toggle("active", b.dataset.rarity==="all"));
  renderSoloWeaponList();
  document.getElementById("solopick").style.display = "flex";
  setTimeout(()=>{ if(search) search.focus(); }, 50);
}

function renderSoloWeaponList(){
  const searchEl = document.getElementById("solopick-search");
  const q = searchEl ? searchEl.value.trim().toLowerCase() : "";
  const list = getSoloPickableList().filter(k=>{
    const w = weapons[k];
    if(soloFilterRarity !== "all" && w.rarity !== soloFilterRarity) return false;
    if(q && !w.displayName.toLowerCase().includes(q)) return false;
    return true;
  });
  const CAP = 150;
  const shown = list.slice(0, CAP);
  const container = document.getElementById("solopick-grid");
  let html = "";
  for(const key of shown){
    const w = weapons[key];
    const statLines = weaponStatLines(w).map(([label,val]) =>
      `<div>${label}<b>${val}</b></div>`
    ).join("");
    html += `
      <div class="choice solopick-card" onclick="pickSoloWeapon('${key}')">
        <div class="rk ${w.rarity}">${w.rarity.toUpperCase()}</div>
        <div class="wname" style="color:${w.c}">${w.displayName}</div>
        <div class="wtype">${w.type}</div>
        <div class="wstats">${statLines}</div>
      </div>`;
  }
  container.innerHTML = html || `<div style="color:var(--dim);letter-spacing:1px;padding:30px;">No weapons match.</div>`;
  const countEl = document.getElementById("solopick-count");
  if(countEl){
    countEl.innerText = list.length > CAP
      ? `Showing ${CAP} of ${list.length} — keep typing to narrow it down`
      : `${list.length} weapon${list.length===1?"":"s"}`;
  }
}

function filterSoloRarity(r){
  soloFilterRarity = r;
  document.querySelectorAll(".solo-rarity-btn").forEach(b => b.classList.toggle("active", b.dataset.rarity===r));
  renderSoloWeaponList();
}

function pickSoloWeapon(key){
  if(!soloPicking || !weapons[key]) return;
  const w = weapons[key];
  player.weaponA = key;
  lastShotA = 0;
  ammo.A = w.mag;
  reloading.A = false; jammed.A = false;
  swarmArsenal = [key];

  document.getElementById("weaponnameA").innerText = w.displayName;
  document.getElementById("solopick").style.display = "none";
  soloPicking = false;

  renderSwarmArsenal();
  spawnParticles(player.x, player.y, w.c, 24);
  playSfx("reload");
  flashWaveMsg("WAVE 1 — " + w.displayName.toUpperCase());
  spawnWave();
}

// =========================================================
// SHOOTING
// =========================================================
function angleToMouseOrTouch(){
  if(gpAim.active){
    return Math.atan2(gpAim.y, gpAim.x);
  }
  if(touchAim.active){
    return Math.atan2(touchAim.dy, touchAim.dx);
  }
  return Math.atan2(mouse.y - player.y, mouse.x - player.x);
}

function fire(){
  if(!started || paused || upgradeMode || switching || soloPicking) return;
  const slot = activeSlot;
  const weaponKey = slot === "A" ? player.weaponA : player.weaponB;
  if(!weaponKey) return;
  if(reloading[slot] || jammed[slot]) return;
  if(!weapons[weaponKey].melee && ammo[slot] <= 0){ startReload(slot); return; }
  fireSlot(slot);
}

function startReload(slot){
  const weaponKey = slot === "A" ? player.weaponA : player.weaponB;
  if(!weaponKey) return;
  const w = weapons[weaponKey];
  if(w.melee || reloading[slot]) return;
  if(ammo[slot] >= w.mag && !jammed[slot]) return;
  reloading[slot] = true;
  jammed[slot] = false;
  reloadStart[slot] = performance.now();
  reloadDuration[slot] = w.reload;
  playSfx("reload");
}

function switchSlot(){
  if(!started || paused || upgradeMode || switching || soloPicking) return;
  if(player.weaponB === null) return; // nothing to switch to
  switching = true;
  switchT = 22; // frames of holster/draw delay
  spawnParticles(player.x, player.y, "#2ee6d6", 6);
}

function fireSlot(slot){
  const weaponKey = slot === "A" ? player.weaponA : player.weaponB;
  const w = weapons[weaponKey];
  const now = performance.now();
  const last = slot === "A" ? lastShotA : lastShotB;
  if(now - last < w.cd) return;
  if(slot === "A") lastShotA = now; else lastShotB = now;
  if(!w.melee) ammo[slot]--;

  runStats.shotsFired++;
  runStats.weaponUse[weaponKey] = (runStats.weaponUse[weaponKey] || 0) + 1;

  const angle = angleToMouseOrTouch();
  const dmg = w.d * bonusDamage * RARITY[w.rarity];

  if(w.melee){
    slashFx.push({ x: player.x, y: player.y, angle, radius: w.range*0.25, maxRadius: w.range, life: 14, maxLife:14, color: w.c, arc: w.aoe ? Math.PI*2 : Math.PI*0.9, thick: !!w.instakill });
    let hitAny = false;
    for(const e of enemies){
      const dist = Math.hypot(e.x-player.x, e.y-player.y);
      if(dist < w.range){
        if(w.aoe || Math.abs(normalizeAngle(Math.atan2(e.y-player.y,e.x-player.x) - angle)) < 1.1){
          damageEnemy(e, dmg, { instakill: !!w.instakill, poison: !!w.poison, color: w.c, n: 6 });
          hitAny = true;
        }
      }
    }
    if(hitAny){ registerHit(); }
    playSfx("melee");
    shakeAmt = Math.min(shakeAmt+(w.instakill?7:3), 10);
    spawnParticles(player.x + Math.cos(angle)*20, player.y + Math.sin(angle)*20, w.c, w.instakill?12:5);
    if(w.rift){
      const bx = player.x + Math.cos(angle)*20, by = player.y + Math.sin(angle)*20;
      bullets.push({
        x: bx, y: by, px: bx, py: by,
        dx: Math.cos(angle)*20, dy: Math.sin(angle)*20,
        d: dmg*0.55, c: w.c, life: 34,
        pierce: 99, hitSet: new Set(),
        explosion: 0, poison:false, chain:false, wtype:"Energy",
      });
      playSfx("shoot_energy");
    }
    return;
  }

  const pellets = w.pellets || 1;
  const spreadDeg = w.spread || (pellets>1 ? 8 : 2.2);
  for(let i=0;i<pellets;i++){
    const off = pellets===1 ? (Math.random()-0.5)*0.02 :
      ((i/(pellets-1)) - 0.5) * (spreadDeg*Math.PI/180) + (Math.random()-0.5)*0.03;
    const a = angle + off;
    const bx = player.x + Math.cos(angle)*18, by = player.y + Math.sin(angle)*18;
    bullets.push({
      x: bx, y: by, px: bx, py: by,
      dx: Math.cos(a)*w.spd, dy: Math.sin(a)*w.spd,
      d: dmg, c: w.c, life: w.range/w.spd,
      pierce: w.pierce || 0, hitSet: new Set(),
      explosion: w.explosion || 0, poison: !!w.poison, chain: !!w.chain,
      instakill: !!w.instakill, wtype: w.type,
      burn: !!w.burn, bounce: w.bounce || 0,
      homing: !!w.homing,
      boomerang: !!w.boomerang, returning: false, outLife: w.range/w.spd,
    });
  }
  spawnParticles(player.x + Math.cos(angle)*18, player.y + Math.sin(angle)*18, w.c, 4);
  muzzleFx.push({ x: player.x+Math.cos(angle)*20, y: player.y+Math.sin(angle)*20, angle, life:6, maxLife:6, color: w.c, big: !!w.explosion || !!w.instakill, energy: w.type==="Energy"||w.type==="Precision" });
  shakeAmt = Math.min(shakeAmt + (w.instakill?6:w.explosion?4:1.4), 10);
  player.thrust = 4;

  const sfxByType = {
    Sidearm:"shoot_sidearm", Auto:"shoot_auto", Burst:"shoot_burst", Spread:"shoot_spread",
    Precision:"shoot_precision", Explosive:"shoot_explosive", Energy:"shoot_energy",
    Toxic:"shoot_toxic", Singularity:"shoot_singularity", Flame:"shoot_flame", Boomerang:"shoot_boomerang",
  };
  playSfx(sfxByType[w.type] || "shoot_auto");

  if(ammo[slot] <= 0) startReload(slot);
}

function easeOutBack(t){
  const c1 = 1.70158, c3 = c1+1;
  return 1 + c3*Math.pow(t-1,3) + c1*Math.pow(t-1,2);
}
function easeOutQuad(t){ return 1 - (1-t)*(1-t); }

function normalizeAngle(a){
  while(a > Math.PI) a -= Math.PI*2;
  while(a < -Math.PI) a += Math.PI*2;
  return a;
}

function registerHit(){
  combo++;
  comboTimer = 110;
}

