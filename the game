  }
  #gameover h1{font-size:56px;letter-spacing:8px;color:var(--accent);margin:0;text-shadow:0 0 30px rgba(255,56,96,.6);
    animation:goShake .5s cubic-bezier(.3,.2,.2,1);}
  @keyframes goShake{
    0%{opacity:0;transform:scale(1.6);letter-spacing:22px;filter:blur(6px);}
    60%{opacity:1;transform:scale(.97);letter-spacing:6px;filter:blur(0);}
