const feedIcons = { normal:"◆", runner:"▲", tank:"■", shooter:"●", boss:"★", bomber:"✸", splitter:"◇", splitling:"▵", shielded:"▣", turret:"⬢", vampire:"♦" };
function pushKillFeed(type){
